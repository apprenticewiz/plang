# Build directories
build/
build-*/
_build/
out/

# CMake generated files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/

# Compiled output
*.o
*.d
*.a
*.so
*.so.*
*.dylib

# Executables (catch stray a.out, test binaries, etc.)
a.out
*.out

# Intermediate compiler output
*.ll
*.s
*.bc

# Python bytecode cache (tools/*.py)
__pycache__/
*.pyc

# clangd / LSP
.cache/
compile_commands.json
.clangd/

# Editor and IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
\#*\#
.#*

# CLion
cmake-build-*/

# macOS
.DS_Store

# Installation trees inside the repo (e.g. local prefix for testing)
usr/
local/

# Agent worktrees and session state.
.claude/
build-asan/
-

# Module interface files, generated as a side effect of compiling a module
# declaration -- should only ever appear in a build/test tmp dir via split-file,
# never in the checked-in source tree (a recurring mistake this guards against).
*.pmi

# Schema-layout sidecar for the gdb pretty-printer (issue #130), written next
# to the source file a -g compile with a runtime-varying schema type used --
# same class of side-effect-of-compiling artifact as *.pmi above.
*.plang-schemas.json
