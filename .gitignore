*.so.*
*.dylib

# Executables (catch stray a.out, test binaries, etc.)
a.out
*.out

# Intermediate compiler output
*.ll
*.s
*.bc

# Python bytecode cache (tools/*.py)
__pycache__/
*.pyc

# clangd / LSP
.cache/
compile_commands.json
.clangd/

# Editor and IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~
*.orig
\#*\#
.#*

# CLion
cmake-build-*/

# macOS
.DS_Store

# Installation trees inside the repo (e.g. local prefix for testing)
usr/
local/

# Agent worktrees and session state.
.claude/
build-asan/
-

# fuzz-scheduled.yml's (issue #183 Phase 2) working corpus and crash-artifact
# directories, at the repo root only -- these are what a scheduled CI run's
# actions/cache restores/saves and where it collects crash files, never
# checked in themselves (the real, curated seed corpus lives, tracked, under
# fuzz/corpus/ instead). Rooted (leading /) so this does not also match
# fuzz/corpus/ itself.
/fuzz-corpus/
/fuzz-crashes/

# Module interface files, generated as a side effect of compiling a module
# declaration -- should only ever appear in a build/test tmp dir via split-file,
# never in the checked-in source tree (a recurring mistake this guards against).
*.pmi
# Exception: the fuzz/ corpus seed is a deliberately checked-in .pmi, not a
# build artifact -- without this exception it silently never gets committed
# (confirmed: this is exactly what happened the first time this file was
# added, breaking the fuzz-smoke CI job with no local warning at all).
!fuzz/corpus/pmi/*.pmi

# Schema-layout sidecar for the gdb pretty-printer (issue #130), written next
# to the source file a -g compile with a runtime-varying schema type used --
# same class of side-effect-of-compiling artifact as *.pmi above.
*.plang-schemas.json
