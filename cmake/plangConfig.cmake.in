@PACKAGE_INIT@

# plangConfig.cmake -- CMake package config for the plang frontend library
# (issue #191). Consumers do:
#
#   find_package(plang REQUIRED)
#   target_link_libraries(my_target PRIVATE plang::plang_frontend)
#
# and get plang::plang_frontend's own public include directory for free
# (see lib/CMakeLists.txt's target_include_directories INSTALL_INTERFACE).
#
# plang_frontend links LLVM PRIVATE -- deliberately: LLVM stays an
# implementation detail so a consumer of plang::plang_frontend does not
# inherit LLVM's own (large) CMake requirements just to link against us.
# find_dependency(LLVM CONFIG) below is still needed because CMake validates
# every target plangTargets.cmake references, including plang_frontend's
# PRIVATE LLVM link interface, at find_package() time -- without this, that
# validation fails even though the consumer never touches LLVM itself.
include(CMakeFindDependencyMacro)
find_dependency(LLVM CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/plangTargets.cmake")

check_required_components(plang)
