(*
RUN: %plang -std=iso10206 %s -o %t
RUN: %t | FileCheck --strict-whitespace --match-full-lines %s
*)

(*
CHECK:[abcd]
*)

program p(output);
type ca = packed array[1..4] of char value 'abcd';
     u  = ca;
     pu = ^u;
var p2: pu;
procedure inner;
type ca = packed array[1..400] of char value '';
begin new(p2); writeln('[', p2^, ']') end;
begin inner end.
