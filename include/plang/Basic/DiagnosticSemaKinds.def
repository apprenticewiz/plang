// DiagnosticSemaKinds.def — Semantic analyzer diagnostics.
// Included by DiagnosticMessages.def.

// ISO 7185 §6.1.6: a label is a digit-sequence in the closed interval 0 to 9999,
// and two labels are the same one when their apparent integral values are equal.
DIAG(err_label_must_be_integer, Error, "label '%0' must be an unsigned integer")
DIAG(err_label_out_of_range, Error, "label '%0' is outside the range 0 to 9999")
DIAG(err_duplicate_label, Error, "duplicate label '%0'")
DIAG(err_duplicate_declaration, Error, "duplicate declaration of '%0'")
DIAG(err_duplicate_type_decl, Error, "duplicate type declaration '%0'")
DIAG(err_duplicate_param, Error, "duplicate parameter name '%0'")
DIAG(warn_label_unreachable, Warning, "label '%0' defined but never reached by goto")
DIAG(err_label_never_placed, Error, "label '%0' declared but never defined as a labeled statement")
// ISO 7185 §6.7.3: Every function must assign to its result variable on every execution path.
// ISO 7185 §6.7.3: Every function must assign to its result variable on every execution path.
DIAG(err_function_no_result, Error, "function '%0' does not assign to its result variable")
// ISO 7185 §6.1.7: A character-string must contain at least one character.
// ISO 7185 §6.1.7: A character-string must contain at least one character.
DIAG(err_empty_string_const, Error, "string constant must contain at least one character")
DIAG(err_substring_non_varstring, Error, "substring operator '[i..j]' requires a string(N) operand")
DIAG(err_unrecognized_expr, Error, "unrecognized expression node")
// EP §6.4.2.5: the only thing that may be done with a value of a restricted
// type is to pass it as a parameter or return it from a function.
DIAG(err_restricted_assigned, Error, "'%0' is a restricted type, so nothing can be assigned to a variable of it")
DIAG(err_restricted_used, Error, "a value of the restricted type '%0' can only be passed as a parameter or returned from a function")
DIAG(err_restricted_component, Error, "'%0' is a restricted type, so its components are not accessible")
DIAG(err_restricted_file_component, Error,
     "'%0' is a restricted type and cannot be the component type of a file")
DIAG(err_undefined_identifier, Error, "undefined identifier '%0'")
// ISO §6.10: every program-parameter besides the required 'input' and
// 'output' -- which the language understands without one -- must be given a
// defining declaration somewhere in the program block.  The heading only
// says which of the block's own declarations are external files (or, under
// Extended Pascal, other bindable entities); it is not a declaration itself.
DIAG(err_program_param_not_declared, Error,
     "program parameter '%0' is never declared in the program block; only "
     "'input' and 'output' need no declaration")
DIAG(err_function_requires_args, Error, "function '%0' requires an argument list")
DIAG(err_proc_as_value, Error, "procedure '%0' cannot be used as a value")
DIAG(err_builtin_proc_as_value, Error, "built-in procedure '%0' cannot be used as a value")
DIAG(err_type_name_as_value, Error, "type name '%0' cannot be used as a value")
DIAG(err_label_as_value, Error, "label '%0' cannot be used as a value")
DIAG(err_subscript_non_array, Error, "subscript operator applied to non-array type '%0'")
// Issue #685: EP §6.8.7's structured-value-constructor is an EXPRESSION, not
// a variable-access -- §6.4.3's field-designator and indexed-variable
// productions both select from a variable-access, and a constructed value
// was never one.  `rec[a:1;b:2].b` and `arr[1:2;3:4][1]` select a component
// of a value that has no storage of its own for CodeGen to select through,
// which (before this diagnostic existed to catch it first) reached two
// different crashes instead of a clean rejection: field access ICE'd
// ("field access on a non-record operand", CGFieldAccess.cpp) because
// emitLValue has no StructuredValueExpr case to find an address through,
// and indexing recursed without bound.  Checked once, here, rather than
// giving both emitFieldGEP and emitIndexGEP their own address-of-a-
// constructor special case for syntax EP never made legal in the first
// place.
DIAG(err_selector_on_structured_value, Error,
     "cannot select a component of a structured-value-constructor result -- "
     "EP §6.4.3 selectors require a variable-access; assign the constructed "
     "value to a variable first")
DIAG(err_index_not_ordinal, Error, "array index must be ordinal, got '%0'")
DIAG(err_index_type_mismatch, Error, "array index type mismatch: index type is '%0' but array expects '%1'")
// A global (or module-level) variable is emitted as a single object in the
// program's .data/.bss, and every reference to it -- from plang's own
// generated code and from the runtime library it links against -- is a
// 32-bit PC-relative relocation.  An object large enough to push other
// symbols more than 2GiB away overflows that relocation at link time with a
// confusing "relocation R_X86_64_PC32 out of range" from ld.lld, naming some
// unrelated runtime function rather than this declaration.  Caught here,
// conservatively, well under that limit -- comfortably below what any
// supported target's addressing can reach, whatever else ends up sharing the
// same image.
DIAG(err_global_var_too_large, Error,
     "'%0' is too large to be a global variable (%1 bytes; the limit is %2 "
     "bytes) -- declare it on the heap (New/GetMem) instead")
// A local (procedure/function-body) variable this large has no relocation to
// overflow -- it is a stack allocation, not a linked object -- but it is no
// safer: it never fits any real stack, and what actually breaks first is the
// LLVM backend lowering the resulting `alloca`.  A single `string(maxint)`
// local was observed driving `llc` to tens of gigabytes of RSS with no
// termination in sight (issue #223), long before the process would ever hit
// a stack-overflow signal.  Gated at the same threshold as
// err_global_var_too_large and for the same "comfortably under any real
// limit" reasoning -- only the wording differs, so the diagnostic names the
// variable's actual scope instead of claiming it is a global.
DIAG(err_local_var_too_large, Error,
     "'%0' is too large to be a local variable (%1 bytes; the limit is %2 "
     "bytes) -- declare it on the heap (New/GetMem) instead")
// A by-value parameter is a variable of its own (ISO §6.6.3.2): the actual
// is copied into it, so it gets exactly the same fixed-size stack `alloca`
// in CodeGen as a local (#223), and hits the same LLVM-backend hang/abort
// lowering it if nothing catches the size first (#410). A `var` parameter
// is deliberately not gated here -- it aliases the caller's own storage
// instead of copying into one of its own, so no oversized local is ever
// materialized for it. Same threshold and remedy shape as
// err_local_var_too_large; "pass it by reference" names the one actually
// available beyond it (the heap is not addressable through a parameter's
// declaration the way New/GetMem addresses a local's).
DIAG(err_param_too_large, Error,
     "'%0' is too large to be a value parameter (%1 bytes; the limit is %2 "
     "bytes) -- pass it by reference ('var') instead")
// A function result -- named or the bare function identifier -- gets its own
// fixed-size stack `alloca` in CodeGen (curRetAlloca), populated on every
// return path exactly like a by-value parameter's copy-in. Same size gate,
// same reasoning, and the same 'var' remedy: a result this large is passed
// back through a `var` parameter instead of the function's own return slot.
DIAG(err_return_type_too_large, Error,
     "return type of '%0' is too large to be a function result (%1 bytes; "
     "the limit is %2 bytes) -- return it through a 'var' parameter instead")
DIAG(err_field_on_non_record, Error, "field access '.%0' on non-record type '%1'")
DIAG(err_no_such_field, Error, "record type '%0' has no field '%1'")
DIAG(err_deref_non_pointer, Error, "dereference operator '^' applied to non-pointer type '%0'")
DIAG(err_op_numeric, Error, "operator '%0' requires numeric operands, got '%1' and '%2'")
DIAG(err_op_divide_numeric, Error, "operator '/' requires numeric operands, got '%0' and '%1'")
DIAG(err_op_integer, Error, "operator '%0' requires integer operands, got '%1' and '%2'")
DIAG(err_op_boolean, Error, "operator '%0' requires boolean operands, got '%1' and '%2'")
// Turbo overloads and/or/xor: logical on two Boolean operands, bitwise on
// two Integer ones (5 and 3 = 1).  err_op_boolean's wording is wrong here --
// it would tell a Turbo programmer their integer operands are the problem,
// when the actual fault is a MIXED pair (one Boolean, one Integer) or some
// third kind entirely.
DIAG(err_op_boolean_or_integer, Error, "operator '%0' requires boolean or integer operands, got '%1' and '%2'")
DIAG(err_op_symdiff_set, Error, "operator '><' requires set operands, got '%0' and '%1'")
DIAG(err_op_set_mixed, Error, "operator '%0' cannot mix set and non-set operands, got '%1' and '%2'")
DIAG(err_op_set_base, Error, "operator '%0' requires sets with compatible base types, got set of '%1' and set of '%2'")
DIAG(err_op_set_ordering, Error, "operator '%0' is not defined for sets; use '<=' or '>=' for set inclusion")
DIAG(err_op_pointer_ordering, Error, "operator '%0' is not defined for pointers; only '=' and '<>' are")
DIAG(err_cannot_compare, Error, "cannot compare '%0' with '%1'")
DIAG(err_in_lhs_not_ordinal, Error, "left operand of 'in' must be ordinal, got '%0'")
DIAG(err_in_rhs_not_set, Error, "right operand of 'in' must be a set type, got '%0'")
DIAG(err_in_incompatible, Error, "type '%0' is not compatible with set of '%1'")
DIAG(err_unknown_binop, Error, "unknown binary operator")
DIAG(err_unary_numeric, Error, "unary '%0' requires a numeric operand, got '%1'")
DIAG(err_not_requires_boolean, Error, "'not' requires a boolean operand, got '%0'")
// Turbo overloads 'not' the same way: bitwise two's-complement negation on
// an Integer operand, logical negation on a Boolean one.
DIAG(err_not_requires_boolean_or_integer, Error, "'not' requires a boolean or integer operand, got '%0'")
// Turbo `@x`: '@' takes the address of a variable, so its operand has to be
// one -- the same requirement a 'var' parameter's argument has
// (err_var_param_needs_lvalue), just spelled for '@' since the operand here
// is not a call argument.
DIAG(err_addrof_requires_variable, Error, "'@' requires a variable, not an expression of type '%0'")
DIAG(err_unknown_unop, Error, "unknown unary operator")
DIAG(err_undefined_function, Error, "undefined function '%0'")
DIAG(err_ordinal_argument, Error, "'%0' requires an ordinal argument, got '%1'")
// issue #261: a required function whose argument is not ordinal-shaped --
// abs, sqr, sqrt, sin, cos, exp, ln, arctan, trunc, round -- is required to
// be numeric instead.  Kept apart from err_ordinal_argument rather than
// folding the two into one "ordinal or numeric" message: a translator
// reading either in isolation can tell what the call actually needed.
DIAG(err_numeric_argument, Error, "'%0' requires a numeric argument, got '%1'")
// issue #306: re/im/arg (EP §6.7.6.2) are the one arithmetic-function family
// that is NOT also polymorphic over integer-type and real-type the way
// sqrt/sin/cos/exp/ln/arctan just above are (ISO 10206 Table 2's own
// operand-type column: footnote (1), "integer-type, real-type, or
// complex-type", for those; footnote (4), "Complex-type" alone, for these
// three) -- so a plain numeric argument needs its own, distinct rejection
// from err_numeric_argument's, which would otherwise wrongly call an
// already-numeric argument "not numeric."
DIAG(err_complex_argument, Error, "'%0' requires a complex argument, got '%1'")
// issue #261: eof/eoln read a file's status, so their (optional) argument
// names the file to test.
DIAG(err_file_argument, Error, "'%0' requires a file argument, got '%1'")
// issue #261: EP §6.7.6.3's card is the cardinality of a set.
DIAG(err_set_argument, Error, "'%0' requires a set argument, got '%1'")
// EP §6.7.6.5: succ/pred's optional second argument is a step count, always
// of type integer regardless of what the first argument's type is.
DIAG(err_step_argument_not_integer, Error,
     "the second argument of '%0' must be an integer, got '%1'")
DIAG(err_write_param_type, Error, "'%0' cannot be written; a write-parameter is an integer, real, boolean, char or string value")
// ISO §6.9.3.1 / EP §6.10.3.1: a write-parameter's field-width and its
// fraction-digits (the expressions after the colons in `e:w:d`) are
// themselves integer-expressions -- not the value being written, which
// err_write_param_type above already covers.
DIAG(err_write_field_not_integer, Error, "write field-%0 must be an integer expression, got '%1'")
// EP §6.9.2.2: the value assigned shall not be longer than the capacity.
DIAG(err_string_too_long, Error, "string of length %0 does not fit a string(%1)")
// ISO §6.4.3.2: a packed array[1..n] of char holds exactly n characters.
DIAG(err_string_length_mismatch, Error,
     "string of length %0 does not fit a packed array[1..%1] of char; "
     "a string-type takes a value of exactly its own length")
DIAG(err_set_elem_not_ordinal, Error, "set elements must be ordinal, got '%0'")
DIAG(err_not_callable, Error, "'%0' is not callable")
DIAG(err_proc_cannot_return_value, Error, "'%0' is a procedure and cannot return a value")
DIAG(err_func_as_statement, Error, "'%0' is a function; use it in an expression, not as a statement")
// TRANSLATORS: %1 is a count, but may read "2 or more" or "1 or 2", built
// in English at the call site.  "argument(s)" is an English plural dodge;
// use whatever your language does for a count that may be one or many.
DIAG(err_wrong_arg_count, Error, "'%0' expects %1 argument(s), got %2")
DIAG(err_var_param_needs_lvalue, Error, "argument %0 of '%1' is a 'var' parameter and requires a variable")
DIAG(err_var_param_type_mismatch, Error, "type mismatch for 'var' parameter '%0': expected '%1', got '%2'")
// ISO §6.6.3.3 requires the same type, and two spellings of the same anonymous
// type-denoter are two types.  Reported separately because naming both sides
// '%1' would otherwise read as a type not matching itself.
DIAG(err_var_param_distinct_anon_type, Error, "'var' parameter '%0' requires the argument to have the same type, but '%1' is written out separately in each place, which declares two distinct types; give the type a name and use that name in both")
// ISO 7185 §6.6.3.3: A tag field, packed-struct component, or packed-array element may not
// be passed as an actual var parameter.
// ISO 7185 §6.6.3.3: A tag field, packed-struct component, or packed-array element may not
// be passed as an actual var parameter.
DIAG(err_tag_field_var_param, Error, "tag field '%0' cannot be passed as a var parameter")
DIAG(err_packed_struct_var_param, Error, "component of packed structure cannot be passed as a var parameter")
DIAG(err_packed_array_var_param, Error, "element of packed array cannot be passed as a var parameter")
DIAG(err_param_type_mismatch, Error, "type mismatch for parameter '%0': expected '%1', got '%2'")
// ISO 7185 §6.6.3.2: A value parameter must not have a type that contains a file component.
// ISO 7185 §6.6.3.2: A value parameter must not have a type that contains a file component.
DIAG(err_file_value_param, Error, "value parameter '%0' has a type containing a file component, which is not permitted")
DIAG(err_lhs_not_lvalue, Error, "left-hand side of assignment is not an assignable variable")
DIAG(err_assign_mismatch, Error, "cannot assign '%0' to variable of type '%1'")
// ISO 7185 §6.4.1: a type is identified by its DECLARATION, not by its name, so
// two declarations may share a spelling and be different types.  Reporting that
// with err_assign_mismatch produces "cannot assign 'r' to variable of type 'r'",
// which states the problem in a form that reads like a compiler bug.
// ISO 7185 §6.4.3.1: `packed` is part of what a record type IS -- two records
// with the same fields and different packing have different layouts.  Saying
// only that the types differ, when they are printed identically, sends the
// reader looking at the field list where nothing is wrong.
// ISO 7185 §6.2.2.9 lets a pointer's domain type be declared later, which is
// what makes `record next: ^t(n) end` legal inside t's own body: a pointer
// needs no size from what it points at.  Without the indirection the type
// contains itself and has no size at all -- and Sema resolved its body while
// resolving its body until the stack ran out, which is a compiler crash where a
// diagnostic belongs.
DIAG(err_schema_recursive, Error,
     "schema '%0' contains itself; a schema may only name itself through a "
     "pointer")
// EP §6.8.7.2: an array-value's case-constant-list selects components of the
// array, so a label outside the index type selects nothing.  Such an arm was
// silently discarded -- the value written in the program simply did not appear.
DIAG(err_constructor_label_out_of_range, Error,
     "index %0 is outside the array's index type %1, so this component value "
     "would be discarded")
DIAG(err_assign_mismatch_packed, Error,
     "cannot assign '%0' to a variable of type '%1': one is packed and the "
     "other is not")
DIAG(err_assign_mismatch_homonym, Error,
     "cannot assign '%0' to a variable of type '%0': these are two different "
     "types that share a name")
DIAG(err_if_not_boolean, Error, "condition of 'if' must be boolean, got '%0'")
DIAG(err_while_not_boolean, Error, "condition of 'while' must be boolean, got '%0'")
DIAG(err_for_var_undefined, Error, "undefined variable '%0' in for statement")
DIAG(err_for_var_not_variable, Error, "for-loop control variable '%0' is not a variable")
DIAG(err_for_var_not_ordinal, Error, "for-loop variable '%0' must be an ordinal type; got '%1'")
DIAG(err_for_var_not_local, Error, "for-loop control variable '%0' must be declared in the immediately enclosing block")
DIAG(err_for_bounds_incompatible, Error, "for-loop bounds have incompatible types ('%0' and '%1')")
// ISO §6.8.3.9: a bound's value is assigned to the control variable each
// iteration, so it must be assignment-compatible with the variable's type --
// not merely with the OTHER bound, which err_for_bounds_incompatible checks.
DIAG(err_for_bound_wrong_type, Error, "for-loop bound has type '%0', incompatible with control variable '%1' of type '%2'")
// ISO 7185 §6.8.3.9: The for-loop control variable must not be modified, read into,
// or passed as a var parameter within the loop body or any called procedure.
// ISO 7185 §6.8.3.9: The for-loop control variable must not be modified, read into,
// or passed as a var parameter within the loop body or any called procedure.
DIAG(err_for_body_assigns, Error, "for-loop control variable '%0' must not be assigned within the loop body")
DIAG(err_for_body_reuses, Error, "for-loop control variable '%0' is reused as inner for-loop control variable")
DIAG(err_for_body_reads, Error, "for-loop control variable '%0' must not be read into within the loop body")
DIAG(err_for_body_var_param, Error, "for-loop control variable '%0' must not be passed as a 'var' parameter within the loop body")
DIAG(err_for_inter_assigns, Error, "procedure accessible from for-loop assigns to control variable '%0'")
DIAG(err_for_inter_reads, Error, "procedure accessible from for-loop reads into control variable '%0'")
DIAG(err_for_inter_var_param, Error, "procedure accessible from for-loop passes control variable '%0' as var parameter")
DIAG(err_repeat_not_boolean, Error, "condition of 'repeat..until' must be boolean, got '%0'")
DIAG(err_undefined_procedure, Error, "undefined procedure '%0'")
// ISO 7185 §6.9.3: write/writeln require at least one value argument.
// ISO 7185 §6.9.3: write/writeln require at least one value argument.
DIAG(err_write_requires_args, Error, "write requires at least one argument")
// ISO 7185 §6.6.5.2: The type read from a file must match the variable type.
// ISO 7185 §6.6.5.2: The type read from a file must match the variable type.
DIAG(err_read_type_mismatch, Error, "type mismatch in read: file element type is '%0', but variable has type '%1'")
// ISO §6.9.2 defines read on a textfile for a variable of an integer, real or
// char type, and Extended Pascal §6.9.2 adds a string type.  Anything else was
// accepted and handed to whichever runtime reader its storage width happened to
// select: a boolean took the integer reader, and a record took it through a
// pointer to the whole record.
DIAG(err_read_param_type, Error,
     "'%0' cannot be read into; a read-parameter is an integer, real or char "
     "variable")
// ISO §6.9.1 / §6.9.2: read(v) and readln(v) are defined as v := f^, so a
// read target must be a variable-access exactly as an assignment's
// left-hand side is (err_lhs_not_lvalue).  Nothing enforced that, so
// `read(5)` or `read(someFunc())` reached codegen with no storage to read
// into and either aborted the compiler outright or silently read into a
// throwaway temporary that nothing could ever see.
DIAG(err_read_not_variable, Error, "read/readln target must be a variable, got '%0'")
// EP §6.7.5.5: readstr(e, v1,...,vn) reads e and assigns every v -- the same
// variable-access requirement err_read_not_variable gives read/readln's
// targets, just for readstr's own v1..vn.  Nothing enforced it here either,
// so a non-variable target reached codegen with no storage to read into and
// aborted the compiler instead of being refused at the call site.
DIAG(err_readstr_not_variable, Error, "readstr target must be a variable, got '%0'")
// EP §6.7.5.5: writestr(e, ...) formats its remaining arguments into e, so e
// itself must be a variable-access to receive the result -- the same
// requirement, for writestr's own destination argument.
DIAG(err_writestr_not_variable, Error, "writestr destination must be a variable, got '%0'")
// EP §6.7.6.7: EQ/LT/GT/NE/LE/GE's arguments "shall each be of char-type or
// the canonical-string-type" — the same requirement §6.8.3.6 gives '+'.
DIAG(err_string_fn_arg_type, Error,
     "'%1' cannot be an argument of %0; it must be char or string")
// ISO 7185 §6.9.1: write(f,e) on a file that is not a textfile is f^ := e,
// so the value written must be assignable to a component.
DIAG(err_write_type_mismatch, Error, "type mismatch in write: file element type is '%0', but value has type '%1'")
// ISO 7185 §6.6.5.4: pack/unpack start-index type must match the array index type.
// ISO 7185 §6.6.5.4: pack/unpack start-index type must match the array index type.
DIAG(err_pack_index_mismatch, Error, "pack: start index type '%0' is not compatible with array index type '%1'")
DIAG(err_unpack_index_mismatch, Error, "unpack: start index type '%0' is not compatible with array index type '%1'")
// ISO 7185 §6.6.5.4: both operands are arrays of one dimension.
// Two, rather than "%0 expects ... its %1 argument" with "packed" or
// "unpacked" supplied as a word.  %0 stays an argument: it is the Pascal
// identifier 'pack' or 'unpack', which no language translates.
DIAG(err_pack_operand_not_array_unpacked, Error,
     "%0 expects an array as its unpacked argument, got '%1'")
DIAG(err_pack_operand_not_array_packed, Error,
     "%0 expects an array as its packed argument, got '%1'")
// ISO 7185 §6.6.5.4: the unpacked operand's type shall not be packed, and
// the packed operand's shall be -- that direction is the entire meaning of
// "pack" and "unpack".  Two diagnostics for the same reason as the pair
// above: %0 is 'pack' or 'unpack' and stays a call, not a description.
DIAG(err_pack_operand_not_unpacked, Error,
     "%0's unpacked argument must not be packed, got '%1'")
DIAG(err_pack_operand_not_packed, Error,
     "%0's packed argument must be packed, got '%1'")
// ISO 7185 §6.6.5.4: a and z shall have identical component types.  CodeGen
// lowers the transfer as one memcpy sized from the unpacked side's element
// type alone, so this has to be identity and not mere assignment
// compatibility -- an integer->real widening is a value conversion a raw
// copy cannot perform, and would silently move the wrong bytes.
DIAG(err_pack_element_type_mismatch, Error,
     "%0: unpacked array has component type '%1', packed array has component type '%2'")
DIAG(err_with_non_record, Error, "'with' expects a record variable, got '%0'")
// ISO §6.8.3.10 / EP §6.8.3.10: a with-statement's record-variable is a
// variable-access, not any record-valued expression -- a function call's
// result has no storage for a with-bound field write to land in.
DIAG(err_with_not_variable, Error, "'with' requires a variable, not an expression of type '%0'")
DIAG(err_goto_undefined, Error, "undefined label '%0'")
// ISO 7185 §6.8.1: A goto may not leave the immediately enclosing block
// or transfer control into a structured statement.
// ISO 7185 §6.8.1: A goto may not leave the immediately enclosing block
// or transfer control into a structured statement.
DIAG(err_goto_outer_block, Error, "goto '%0' leaves this block for a label that is not at the outermost level of the block declaring it")
DIAG(err_goto_into_structured, Error, "goto '%0' jumps into a structured statement")
// EP §6.11.2: a module's 'to begin do'/'to end do' runs once and returns,
// unlike a program's block or an enclosing procedure, which stay on the call
// stack for as long as anything nested in them could still run.  A procedure
// the module declares stays callable for the rest of the program's life, so a
// non-local goto from one back into the module's own block could resume an
// activation that has already ended.
DIAG(err_goto_module_block, Error, "goto '%0' cannot reach a label of a module's block from one of the module's procedures")
// -std=turbo (matching FPC): unlike ISO 7185/EP, a goto may never leave the
// block of the procedure/function/program it appears in -- there is no
// setjmp/longjmp-shaped non-local goto in Turbo Pascal at all, only a goto
// within one routine's own block (which may still freely leave, though not
// enter, a nested structured statement there; see err_goto_into_structured).
DIAG(err_goto_nonlocal_turbo, Error,
     "goto '%0' cannot leave this routine for a label of an enclosing one; "
     "-std=turbo does not allow a non-local goto")
DIAG(err_label_not_declared, Error, "label '%0' used as a statement but not declared in label section")
DIAG(err_label_wrong_block, Error, "label '%0' is declared in an enclosing block, so the statement it labels must be in that block too")
DIAG(err_case_selector_not_ordinal, Error, "case selector must be an ordinal type, got '%0'")
DIAG(err_case_label_mismatch, Error, "case label type '%0' is not compatible with selector type '%1'")
// The label is spelled the way the program wrote it — 'a', not 97 — so the
// quotes belong to the value and not to the sentence around it.
DIAG(err_case_label_duplicate, Error, "case label %0 is used by more than one arm")
// ISO §6.8.3.5: a case-label is a case-constant.  A label that is not one was
// accepted and lowered to a LOAD of the variable, so `case i of 1..n:` with n a
// variable compared against whatever n happened to hold -- an illegal program
// compiled into a plausible-looking one.
DIAG(err_case_label_not_const, Error, "case label is not a constant")
DIAG(err_variant_label_duplicate, Error, "case label %0 is used by more than one variant")
// ISO §6.4.3.3: tag-type is an ordinal-type, whether or not a tag-field name
// was written before it ('case b: boolean of' vs. anonymous 'case boolean of').
DIAG(err_variant_tag_not_ordinal, Error, "variant tag type must be an ordinal type, got '%0'")
// ISO §6.4.3.3: a variant's case-constants are values of the tag field's own
// type, the same rule a case-statement's labels are held to against its
// selector (err_case_label_mismatch) -- worded separately because this one
// names a declared tag type rather than a selector expression's type.
DIAG(err_variant_label_type, Error,
     "variant case-constant has type '%0', which is not compatible with tag type '%1'")
// %1 is the file's own full type name (Type::Name) -- "file of char", "file
// of integer", or, for a genuinely untyped `file` (no `of` clause, only
// reachable under -std=turbo -- ISO/EP have no untyped file), plain "file"
// with no "of ..." to name.  Every call site passes T->ElemType->Name for a
// TYPED file, or T->Name itself for an untyped one -- NOT T->ElemType->Name
// unconditionally, which used to read "not to 'file of file'" for the
// untyped case (this diagnostic's own %1 used to be just the element name,
// with "file of" baked into the format string here).
DIAG(err_line_proc_not_text, Error, "'%0' applies to a text file only, not to '%1'")
// EP §6.7.5.2: reset/rewrite/extend/update's optional second argument names
// the external file, and CodeGen's marshalling (StringCallMarshalling::
// emitCStrArg) only knows how to turn a char or string-kind value into the
// `const char *` the runtime open call takes.  Nothing checked that before
// codegen saw it, so `reset(f, 42)` (or a Boolean, a record, an array, ...)
// reached emitCStrArg with a value shaped nothing like a string, which
// LLVM's own IR verifier rejected -- as an internal-error abort of the whole
// compiler, not a diagnostic -- rather than plang ever refusing the program.
DIAG(err_reset_rewrite_arg_type, Error,
     "'%0' external file name must be char or string, got '%1'")
// -std=turbo only: the mirror image of err_reset_rewrite_arg_type just
// above.  Real Turbo Pascal's Reset/Rewrite second argument is an INTEGER
// RecSize for an untyped file, not a filename -- confirmed against
// `fpc -Mtp`, which rejects `reset(f, 'x.txt')` with an incompatible-type
// error of its own.  See this diagnostic's call site (SemaStmt.cpp) for why
// plang used to accept a string here under Turbo and no longer does.
DIAG(err_turbo_reset_rewrite_recsize_type, Error,
     "'%0' record-size argument must be an integer, got '%1'")
// -std=turbo only: real Turbo Pascal has no plain Read/Write on an untyped
// file at all -- only BlockRead/BlockWrite (not yet implemented, a later
// Tier 3 item) can transfer an untyped file's bytes.  Confirmed against
// `fpc -Mtp`: `read(f, c)` for `var f: file;` is rejected outright with
// "Can't use read or write on untyped file", not given some ad-hoc
// byte-level meaning.  Before this diagnostic existed, plang silently
// treated an untyped file exactly like `text` here (see isTextFile's own
// doc comment, Type.h) -- `read`/`write` "worked", but ran the char/text
// formatting path against raw file bytes, silently wrong rather than
// refused.
DIAG(err_turbo_untyped_file_read_write, Error,
     "cannot use '%0' on an untyped file; use BlockRead/BlockWrite")
// -std=turbo only: TP typed-file Read/Write requires the value's type to be
// IDENTICAL to the file's component type -- no implicit widening the way
// ISO's assignment-compatibility rule (isAssignCompatible, applied to
// `f^ := e` per §6.9.1) allows for e.g. an Integer value into a Real file
// component.  See this diagnostic's call site (BuiltinIO.cpp emitWriteArgs
// and SemaStmt.cpp's read arm) for the exact-identity check it replaces
// CoerceToType/isAssignCompatible with under Turbo.
DIAG(err_turbo_typed_file_exact_type, Error,
     "'%0': file element type is '%1', but value has type '%2' -- "
     "Turbo Pascal requires an exact type match, not just assignment compatibility")
DIAG(err_assign_file, Error, "a variable of a file type, or with a file component, cannot be assigned")
DIAG(err_function_result_type, Error, "a function result must be a simple or pointer type, not '%0'")
DIAG(err_duplicate_enum_value, Error, "duplicate enumeration value '%0'")

DIAG(err_duplicate_field, Error, "duplicate field name '%0' in record")
DIAG(err_set_base_not_ordinal, Error, "set base type must be ordinal; got '%0'")
DIAG(err_set_base_too_wide, Error,
     "set base type '%0' exceeds the %1-element limit on sets")
// An untyped set-constructor (no adopting named set type) has no declared
// base type to check, so its window is read off its own elements instead --
// see literalSetWindow.  Without this, `x in [0, 300]` or `card([0, 300])`
// derived a window from the elements but never checked it against the same
// PlangMaxSetElements limit a named `set of` type is held to, so codegen's
// bitmask silently dropped whichever elements fell outside it.
DIAG(err_set_lit_too_wide, Error,
     "set constructor spans %0..%1, which exceeds the %2-element limit on sets")
DIAG(err_file_component_is_file, Error, "file component type must not itself be a file type")
// Issue #167: this used to only look one record level deep -- a field
// directly on the component record -- so a file nested inside an array, or
// inside a record nested inside another record (etc.), was silently
// accepted.  typeContainsFile already walks arrays, records, conformant
// arrays and schema bodies recursively for the assignment/parameter/
// result-type checks below; this reuses it here too, so this one
// diagnostic now also covers the direct-field case that the old,
// since-removed err_file_field_has_file used to report on its own.
DIAG(err_file_component_has_file, Error,
     "'%0' contains a file type inside a record or array, and cannot be a file's component type")
// Issue #241: get/read/put/position all derive the file's component stride
// from this type's byte size, and disagree about what a zero-size component
// means -- fread and an fseek(0) are no-ops, so read never moves the file
// position (eof can never become true: an infinite loop), while get's
// single-character lookahead fallback moves it by one byte regardless, as
// though the component were a char. No stride reconciles both, so the type
// is rejected instead.
DIAG(err_file_component_zero_size, Error, "'%0' has zero size and cannot be a file's component type")
DIAG(err_string_cap_not_int, Error, "string capacity must be an integer constant expression")
DIAG(err_string_cap_not_positive, Error, "string capacity must be positive; got %0")
// ISO §6.4.3.2, §6.4.2.4: an index type and a subrange are written with
// constants, so the extent of the type is known wherever the type is.
// One diagnostic per bound rather than "%0 bound" with "lower" or "upper"
// passed in: the adjective was an English word traveling into a frame chosen
// by the caller, which is two things a translator cannot see at once.
DIAG(err_array_lower_bound_not_const, Error,
     "lower bound of array index type is not a constant expression; "
     "for a run-time length use a schema type, 'type t(n: integer) = array[1..n]'")
DIAG(err_array_upper_bound_not_const, Error,
     "upper bound of array index type is not a constant expression; "
     "for a run-time length use a schema type, 'type t(n: integer) = array[1..n]'")
DIAG(err_subrange_lower_bound_not_const, Error,
     "lower bound of subrange is not a constant expression")
DIAG(err_subrange_upper_bound_not_const, Error,
     "upper bound of subrange is not a constant expression")
// ISO §6.4.3.2: an index type is an ordinal type of known extent.  'integer'
// is ordinal but names no bounded range, so it is turned away here too.
DIAG(err_array_index_not_ordinal, Error,
     "'%0' cannot be an array index type; "
     "an index type is an ordinal type with a bounded range")
DIAG(err_bound_range_inverted, Error,
     "lower bound %0 exceeds upper bound %1, so the type has no values")
// ISO §6.4.2.2: a subrange-type's two bounds are constants of the SAME
// ordinal type, which becomes the subrange's host type; ISO §6.4.3.2 makes
// an index type written as a range the same rule.  Each bound used to be
// checked only for being ordinal on its own, never against the OTHER
// bound, so `1..b` (integer, enum) and `'a'..100` (char, integer) were
// both silently accepted with whichever bound came first deciding the
// host type and the other's disagreement going unheard (issue #251).
DIAG(err_bound_types_differ, Error,
     "lower bound has type '%0' but upper bound has type '%1'; "
     "both bounds of a range must be of the same ordinal type")
// ISO §6.6.3.1: procedural and functional parameters
DIAG(err_proc_param_needs_proc_name, Error,
     "parameter '%0' is a procedural parameter, so the argument must be the name "
     "of a procedure or function")
DIAG(err_proc_param_is_required, Error,
     "'%0' is a required procedure or function and cannot be passed as a "
     "parameter")
DIAG(err_proc_param_not_congruous, Error,
     "'%0' has signature '%1', which is not congruous with parameter '%2' of "
     "type '%3'")
DIAG(err_proc_param_not_assignable, Error,
     "'%0' is a procedural parameter and cannot be assigned to")
DIAG(err_unrecognized_type, Error, "unrecognized type expression")
// Turbo Tier 5, Cluster A item 1: real Turbo Pascal (confirmed against a
// local fpc -Mtp build) has no anonymous object type -- 'var x: object ...
// end' is refused ("Anonymous class definitions are not allowed") --
// because an object's identity (VMT slot table, ancestor chain) has to be
// nameable for inheritance and dispatch to mean anything.  So an
// ObjectTypeNode is only ever resolved as the direct right-hand side of a
// 'type Name = object ... end' declaration; reached any other way (a field
// type, an array element type, a var's inline type, ...) it is this error.
DIAG(err_object_type_anonymous, Error,
     "object types must be named by a type declaration; an anonymous "
     "object type is not allowed")
// Turbo Tier 5, issue #617: real Turbo Pascal (confirmed against a local
// fpc -Mtp build: "Local class definitions are not allowed") has no
// procedure-local object type either.  Every method's own out-of-line body
// is emitted as an ordinary, non-nested function taking only 'Self' and its
// declared parameters -- never a static-link frame the way a genuinely
// nested PROCEDURE's own body gets one (CodeGenProcs.cpp's method pre-pass)
// -- so a method of a procedure-local object type trying to reach that
// procedure's own locals/parameters has no way to.  Unchecked, this reached
// CodeGen as an LLVM IR verifier failure ("Incorrect number of arguments
// passed to called function") instead of a clean diagnostic.
DIAG(err_object_type_local_to_proc, Error,
     "object type '%0' may not be declared inside a procedure or function")
// Turbo Tier 5, Cluster A item 1: an ancestor clause names a type that
// either was never declared at all, or was declared but is not itself an
// object type -- confirmed against a local fpc -Mtp build for both
// ("Identifier not found" / "class type expected, but got ...").
DIAG(err_object_ancestor_not_found, Error,
     "ancestor type '%0' is not declared")
DIAG(err_object_ancestor_not_object_type, Error,
     "ancestor '%0' is not an object type")
// Turbo Tier 5, Cluster A item 1: two members (fields or methods) of one
// object type sharing a name.  Real Turbo Pascal has no method overloading
// (confirmed against a local fpc -Mtp build: "Procedure overloading is
// switched off"), so a second method of the same name in the same type is
// rejected outright, exactly like a duplicate field.
DIAG(err_object_duplicate_member, Error,
     "duplicate member name '%0' in object type '%1'")
// Turbo Tier 5, Cluster A item 1: confirmed against a local fpc -Mtp build
// ("Virtual constructors are only supported in class object model") that a
// TP7 object-model constructor can never be virtual -- only a destructor
// (or an ordinary method) may be.
DIAG(err_object_virtual_constructor, Error,
     "constructor '%0' may not be declared 'virtual'")
// Turbo Tier 5, Cluster A item 1: confirmed against a local fpc -Mtp build
// ("Only virtual methods can be abstract") that 'abstract' with no
// 'virtual' is a semantic error, not merely an unusual ordering -- the
// parser (Parser::parseObjectMethodHeading) accepts either order or
// 'abstract' alone precisely because this is Sema's rule to enforce, not
// the grammar's.
DIAG(err_object_abstract_not_virtual, Error,
     "method '%0' is declared 'abstract' but not 'virtual'")
// Turbo Tier 5, Cluster A item 1: confirmed against a local fpc -Mtp build
// ("function header doesn't match the previous declaration") that a virtual
// method overriding an inherited one of the same name must match its
// signature exactly (arity, parameter types, return type) -- unlike a
// non-virtual redeclaration of the same name, which merely HIDES the
// inherited method (a static redeclaration, warned about by fpc as "An
// inherited method is hidden") and is free to differ.
DIAG(err_object_virtual_override_signature_mismatch, Error,
     "virtual method '%0' does not match the signature of the inherited "
     "method it overrides")
// Turbo Tier 5, Cluster A item 1: an out-of-line method body ('procedure
// T.M; begin ... end;') whose 'T.M' names no in-class heading declared in
// object type T -- either T does not exist/is not an object type, or T has
// no member named M.
DIAG(err_object_method_body_without_heading, Error,
     "'%0.%1' has no matching method heading in object type '%0'")
// Turbo Tier 5, Cluster A item 1: a second out-of-line body for the same
// in-class heading.
DIAG(err_object_method_body_duplicate, Error,
     "method '%0.%1' already has a defining declaration")
// Turbo Tier 5, Cluster A item 1: confirmed against a local fpc -Mtp build
// ("Abstract methods shouldn't have any definition") that an abstract
// method may never be given a body, out-of-line or otherwise.
DIAG(err_object_abstract_method_has_body, Error,
     "abstract method '%0.%1' may not have a body")
// Turbo Tier 5, Cluster A item 1: an out-of-line body's own heading
// (parameters, return type) does not match the in-class heading it is the
// body for.  Reuses the same arity/parameter/return-type checks as an
// ordinary forward declaration's own body (err_forward_param_count/
// err_forward_param_type/err_forward_return_type), just worded for a
// method rather than a plain procedure.
DIAG(err_object_method_param_count, Error,
     "implementation of '%0.%1' has %2 parameter(s) but its heading had %3")
DIAG(err_object_method_param_type, Error,
     "parameter '%0' of '%1.%2': type '%3' does not match the heading's "
     "type '%4'")
DIAG(err_object_method_return_type, Error,
     "return type of '%0.%1' does not match its heading")
// Turbo Tier 5, Cluster A item 1: confirmed against a local fpc -Mtp build
// ("Forward declaration not solved") that every non-abstract method heading
// -- virtual or not -- needs an out-of-line body somewhere in the same
// compilation; only an abstract method is exempt (it has no body by
// construction -- err_object_abstract_method_has_body above is the
// opposite mistake).
DIAG(err_object_method_never_defined, Error,
     "method '%0.%1' is declared but never given a defining declaration")
// Turbo Tier 5, Cluster A item 1: confirmed against a local fpc -Mtp build
// ("An inherited method is hidden by ...") that redeclaring an inherited
// method's name WITHOUT 'virtual' is legal -- it statically hides the
// ancestor's method rather than overriding it through the VMT -- but is
// worth flagging, the same way fpc itself does, since it is easy to write
// by accident (forgetting 'virtual' on what was meant as an override).
DIAG(warn_object_method_hides_inherited, Warning,
     "method '%0' hides the inherited method of the same name; declare "
     "'virtual' to override it instead")
// Turbo Tier 5, Cluster A item 3: 'Obj.Method(...)'/'Obj.Method' where Obj's
// (or 'P^'s) static type is not TypeKind::Object -- the parser builds a
// MethodCallExpr/MethodCallStmt for `.identifier` unconditionally (see
// MethodCallExpr's own comment, AstExpr.h) whenever it is possible this is a
// method call at all, and this is Sema's rejection of the cases that are
// not: an ordinary record field, a plain variable, ... none of which this
// codebase has any procedural-valued form of to call.
DIAG(err_method_call_receiver_not_object, Error,
     "'%0' is not an object; '.' followed by '(' is only a method call")
// Turbo Tier 5, Cluster A item 3: Obj's object type (or one of its
// ancestors, walked the same way resolveObjectType's own VMT-slot
// inheritance does) has no method of this name.  The record-field sibling
// is err_no_such_field; kept distinct because the receiver here is
// confirmed to already be an object type, so "no such field" would suggest
// the wrong fix (this is never a field lookup to begin with).
DIAG(err_object_method_not_found, Error,
     "object type '%0' has no method '%1'")
// Turbo Tier 5, Cluster A item 5: 'inherited' (with or without a following
// method name) used outside an object method's own body -- there is no
// enclosing method to ask "the direct ancestor of WHAT" about, matching
// fpc -Mtp's own rejection of 'inherited' at ordinary procedure/program scope.
DIAG(err_inherited_outside_method, Error,
     "'inherited' may only be used inside an object method")
// Turbo Tier 5, Cluster A item 5: the enclosing method's own object type has
// no ancestor at all ('object type 'T' has no ancestor for 'inherited' to
// reach') -- confirmed against fpc -Mtp for an EXPLICIT 'inherited Name'/
// 'inherited Name(...)'.  Issue #624: that confirmation did not hold for the
// BARE 'inherited;' form (Method empty) used as a full STATEMENT -- fpc
// treats that one combination as a legal no-op instead (the common
// defensive "always call inherited at the top of every constructor/
// destructor" idiom, written even on a hierarchy's own root), so
// Sema::checkInheritedCall never reaches this diagnostic for it -- see that
// function's own comment for the full three-way split.
DIAG(err_inherited_no_ancestor, Error,
     "object type '%0' has no ancestor for 'inherited' to reach")
// Turbo Tier 5, Cluster A item 5: 'inherited Name(...)' where no ancestor in
// the chain (searched starting at the DIRECT parent, never this type itself)
// declares a method of that name -- the 'inherited' sibling of
// err_object_method_not_found just above.
DIAG(err_inherited_method_not_found, Error,
     "ancestor of object type '%0' has no method '%1' for 'inherited' to reach")
// Issue #574: 'inherited MethodName(...)' (or the bare form) resolves to a
// STATIC call to the ancestor's own body (docs/turbo.md, "Object types") --
// but an 'abstract' method has no body at all, only CodeGenProcs.cpp's
// emitAbstractMethodStub, which unconditionally raises Runtime error 211.
// Confirmed against a local fpc -Mtp build ("Abstract methods cannot be
// called directly"): this is refused at COMPILE time, not deferred to
// whichever run happens to execute the 'inherited' call.
DIAG(err_inherited_abstract_method, Error,
     "cannot call abstract method '%0.%1' via 'inherited'")
// Issue #616: a bare 'inherited;' forwards THIS activation's own actual
// parameter values, by position, straight into the resolved ancestor
// method's own parameter list -- well-typed only when the two signatures
// are IDENTICAL.  A true virtual override already guarantees that
// (err_object_virtual_override_signature_mismatch), but a static hide of an
// inherited method (legal here), or two same-named methods that merely
// coincide across levels, do not.  Confirmed against a local fpc -Mtp
// build ("Wrong number of parameters specified for call to ...") that even
// an ordinarily call-compatible widening conversion is rejected for the
// bare form -- it requires an exact match, not merely a compatible one.
DIAG(err_inherited_bare_signature_mismatch, Error,
     "bare 'inherited' in '%0' cannot forward its own parameters to "
     "ancestor method '%1.%2': the signatures do not match")
// Turbo Tier 5, Cluster A item 7: 'Obj.Field'/'P^.Field' for an object type
// -- err_no_such_field's Object-kind sibling (kept distinct so its wording
// says "object type" rather than "record type", matching
// err_object_method_not_found's own precedent just above).
DIAG(err_object_no_such_field, Error,
     "object type '%0' has no field '%1'")
// Turbo Tier 5, Cluster A item 7: a 'private' field or method accessed from
// outside the module (program or unit) that declares its object type.
// Confirmed against a local fpc -Mtp build: private is scoped to the whole
// declaring MODULE, not to the exact type or even to a method body -- any
// code in the SAME module (a descendant type's own methods, or even
// ordinary code with no method context at all) may reach it, and only a
// DIFFERENT module (reached through 'uses') is refused ("identifier idents
// no member").
DIAG(err_object_private_field, Error,
     "field '%1' of object type '%0' is private to its own module")
DIAG(err_object_private_method, Error,
     "method '%1' of object type '%0' is private to its own module")
DIAG(err_undefined_type, Error, "undefined type '%0'")
DIAG(err_not_a_type, Error, "'%0' is not a type")
// EP §6.2.1(k): the relaxation that lets declaration parts appear in any
// order explicitly retains "the prohibition of forward references in
// declarations" — the one exception is a pointer's domain type (ISO
// §6.2.2.9), which needs no size from what it points at.
DIAG(err_forward_type_reference, Error,
     "type '%0' is used here before its declaration; only a pointer's "
     "domain type may be declared later")

// Forward declaration signature checks
// TRANSLATORS: "parameter(s)" is an English plural dodge.  Use whatever
// your language does for a count that may be one or many.
DIAG(err_forward_param_count, Error, "implementation of '%0' has %1 parameter(s) but forward declaration had %2")
DIAG(err_forward_param_type, Error, "parameter '%0' of '%1': type '%2' does not match forward declaration type '%3'")
DIAG(err_forward_return_type, Error, "return type of '%0' does not match forward declaration")
DIAG(err_function_no_result_type, Error,
     "function '%0' has no result type; only the defining occurrence of a "
     "function declared 'forward' may leave it out")
// ISO §6.6.1: the forward directive promises a defining occurrence of the
// same procedure- or function-identifier "later in the same block".
// Nothing audited that promise, so a forward declaration with no matching
// definition compiled clean and only failed at link time, against the
// mangled name rather than the source identifier that is actually missing.
DIAG(err_forward_never_defined, Error,
     "'%0' is declared 'forward' but is never given a defining declaration "
     "in this block")

// Issue #698: a unit's interface heading and its implementation's body for
// the same name did not previously have anything comparing them, so a
// mismatched implementation shadowed the interface's own heading unchecked
// and only failed to LINK, at every caller, once the interface's heading was
// never actually defined.  Worded like err_object_method_param_count/
// _param_type/_return_type/_never_defined just above (Turbo Tier 5, Cluster
// A item 1's own precedent for the exact same interface/body relationship,
// just for a method instead of a plain unit-level routine); confirmed
// against a local fpc -Mtp build ("function header doesn't match",
// "Forward declaration not solved") that both directions are real fpc
// diagnostics.
DIAG(err_unit_impl_param_count, Error,
     "implementation of '%0' has %1 parameter(s) but its interface heading had %2")
DIAG(err_unit_impl_param_type, Error,
     "parameter '%0' of '%1': type '%2' does not match its interface "
     "heading's type '%3'")
DIAG(err_unit_impl_return_type, Error,
     "return type of '%0' does not match its interface heading")
DIAG(err_unit_impl_never_defined, Error,
     "'%0' is declared in this unit's interface but is never given a "
     "defining declaration in the implementation")

// EP Tier 5 — Function/Procedure Enhancements
DIAG(err_protected_param_assigned, Error, "assignment to protected parameter '%0' (EP §6.7.3.1)")
// EP §6.7.3.7.1 NOTE 2: a conformant-array bound identifier denotes the
// actual argument's bound and is neither constant nor a variable -- it may
// be read but not assigned.
DIAG(err_conformant_bound_assigned, Error,
     "assignment to conformant-array bound '%0' (EP §6.7.3.7.1)")
DIAG(err_type_of_undefined, Error, "'type of %0': '%0' is not defined")
DIAG(err_for_in_not_set, Error, "'for ... in' requires a set-type expression, got '%0'")
// ISO 10206 §6.9.3.9.1 (issue #689): the control variable of a
// `for v in set do` is an ordinary variable-access, not implicitly
// declared -- so its type must agree with the set's element type the same
// way an ordinary for-loop's control variable must agree with its bounds.
DIAG(err_for_in_var_wrong_type, Error,
     "loop variable '%0' has type '%1', incompatible with set element type '%2'")
DIAG(err_conformant_actual_not_array, Error, "conformant array parameter '%0' requires an array argument, got '%1'")
DIAG(err_conformant_elem_mismatch, Error, "element type mismatch for conformant array parameter '%0': expected '%1', got '%2'")
// ISO §6.7.3.8 a) and d): the other two ways an array argument can fail to
// be conformable with a conformant-array-schema, checked before the element
// type so a mismatch there is not misreported as an element-type mismatch
// when the element types actually agree (see isConformable).
DIAG(err_conformant_index_type_mismatch, Error,
     "index type mismatch for conformant array parameter '%0': schema expects '%1', argument has '%2'")
DIAG(err_conformant_packed_mismatch, Error,
     "conformant array parameter '%0' is %1 but the argument is %2")

// EP §6.4.7: Schema types
DIAG(err_schema_not_defined, Error, "'%0' is not a schema type")
// TRANSLATORS: "discriminant(s)" is an English plural dodge.
DIAG(err_schema_wrong_arg_count, Error, "schema '%0' expects %1 discriminant(s), got %2")
DIAG(err_schema_disc_not_const, Error, "schema discriminant '%0' must be a constant expression")
DIAG(err_schema_undiscriminated, Error,
     "schema '%0' needs its discriminants here, as in '%0(...)'; a schema name "
     "stands alone only as a parameter type or as the domain of a pointer")
// EP §6.4.4 and §6.7.3.7 both admit a bare schema-name here, so the limit is
// plang's and the message says whose it is and what to write instead.  Not
// "its size varies": `record k: 1..n end` is rejected too, and its storage is
// the same whatever n is -- what varies there is the range k is checked against.
DIAG(err_schema_body_not_representable, Error,
     "plang does not implement schema '%0' without its discriminants: only an "
     "array body recomputes its extent from them at run time, and any other "
     "body needs their values to lay itself out and to range-check; Extended "
     "Pascal allows this, so write them out, as in '%0(...)'")
// ISO 7185 §6.6.5.3: new's first parameter is a pointer variable -- the
// procedure creates a fresh variable and makes the pointer refer to it.
// Only the Pointer-Kind case computed a Pointee; every other kind left it
// null and fell through every check below untouched, so `new(i)` for a
// plain `integer` i reached CodeGen with nothing to size an allocation from
// and hit a codegenICE -- an implementation crash where the standard calls
// for the program to be rejected here.
DIAG(err_new_arg_not_pointer, Error,
     "'new' expects a pointer as its first argument, got '%0'")
// ISO 7185 §6.6.5.3: dispose's argument is the same pointer variable new
// created; dispose's own argument-checking block (added for #253) resolves
// its type the same way new's does but never added the matching
// non-Pointer check new's own #206 fix gave it, so `dispose(i)` for a plain
// `integer` i reached CodeGen with no pointee to size and hit an LLVM IR
// verifier abort instead of being rejected here.
DIAG(err_dispose_arg_not_pointer, Error,
     "'dispose' expects a pointer as its first argument, got '%0'")
// -std=turbo only: GetMem/FreeMem's own first argument, the same rule as
// new/dispose just above but shared by both spellings via %0 rather than
// each getting its own hardcoded-name diagnostic (SemaStmt.cpp's GetMem/
// FreeMem arm).
DIAG(err_heap_arg_not_pointer, Error,
     "'%0' expects a pointer as its first argument, got '%1'")
// TRANSLATORS: "discriminant(s)" is an English plural dodge.
DIAG(err_schema_new_needs_discs, Error,
     "'new' for a pointer to schema '%0' needs %1 discriminant(s), got %2")
DIAG(err_schema_new_disc_type, Error,
     "discriminant '%0' of schema '%1' needs an ordinal value")
DIAG(err_new_extra_args, Error,
     "'new' takes extra arguments only for a record with a variant part or a "
     "schema, and '%0' is neither")
// TRANSLATORS: %0 is always 'string'; it is passed so the quoting matches.
DIAG(err_new_string_capacity, Error,
     "plang does not implement '%0' as a schema, so 'new' cannot be given a "
     "capacity for it; write the capacity in the pointer's domain type, as in "
     "'^string(20)'")
// Turbo Tier 5, Cluster A item 6: 'new(p, X)' / 'new(p, X(...))' where p's
// pointee is an object type but the second argument is not a genuine
// constructor call -- either no CallExpr shape at all ('new(p, 5)',
// 'new(p, SomeVar)'), or the wrong number of top-level arguments to 'new'
// itself.  A bare 'new(p)' (no second argument) is unaffected -- confirmed
// legal against a local fpc -Mtp build, allocating with no constructor run
// at all (real Borland/FPC's own "use extended syntax" warning, which
// plang does not reproduce).
DIAG(err_new_object_needs_init, Error,
     "'new' for a pointer to object type '%0' needs a constructor call, as "
     "in 'new(p, Init(...))'")
// Turbo Tier 5, Cluster A item 6: the named callee IS a real method of
// Pointee's own ancestor chain, but not one declared 'constructor'.
DIAG(err_new_init_not_constructor, Error,
     "'%1' is not a constructor of object type '%0'")
// Issue #622: 'p := New(PtrType[, Ctor[(args)]])' -- New's own FUNCTION
// form (real Borland/FPC's "extended syntax", confirmed against a local
// fpc -Mtp build). PtrType is a POINTER TYPE identifier, never a value and
// never the pointee type alone ('New(TFoo)' for an unpointered object type
// is refused too: "pointer type expected").
DIAG(err_new_function_arg_not_pointer_type, Error,
     "the function form of 'new' expects a pointer type as its argument, "
     "got '%0'")
// Issue #622: err_new_object_needs_init's function-form sibling -- the
// same "wrong number of top-level arguments" shape, worded with the
// function form's own call syntax rather than the statement form's.
DIAG(err_new_function_object_needs_init, Error,
     "the function form of 'new' for a pointer to object type '%0' needs a "
     "constructor call, as in 'New(PtrType, Init(...))'")
// Issue #622: an extra argument on the function form of 'new' is only ever
// a constructor call, for a pointer to an OBJECT type -- unlike the
// statement form, there is no confirmed real-world function-New idiom for
// a schema (Extended Pascal, which has no function-New at all -- this
// arm is Turbo-only) or a variant record's own case-constants, so both are
// refused here with a clear diagnostic rather than silently mishandled.
DIAG(err_new_function_extra_args, Error,
     "the function form of 'new' takes an extra argument only for a "
     "pointer to an object type (a constructor call), and '%0' is not one")
// Turbo Tier 5, Cluster A item 6: 'dispose(p, Dtor)' mirrors
// err_new_object_needs_init above.
DIAG(err_dispose_object_needs_done, Error,
     "'dispose' for a pointer to object type '%0' needs a destructor call, "
     "as in 'dispose(p, Done)'")
// Turbo Tier 5, Cluster A item 6: err_new_init_not_constructor's mirror.
DIAG(err_dispose_done_not_destructor, Error,
     "'%1' is not a destructor of object type '%0'")
// Turbo Tier 5, Cluster A item 6: 'Fail' (TP-only, Builtins.def) used
// outside a constructor's own body.  Confirmed against a local fpc -Mtp
// build that 'Fail' is not even a recognized identifier outside a
// constructor ("Identifier not found") -- plang gives it a dedicated
// diagnostic instead of reusing the generic undefined-identifier one,
// matching the same "context-restricted required identifier" treatment
// err_inherited_outside_method already gives 'inherited'.
DIAG(err_fail_outside_constructor, Error,
     "'Fail' may only be used inside a constructor")
// ISO 10206 §6.6.5.3: 'dispose(p, e1,...,es)' where p's domain-type is a
// schema-name may re-supply the discriminants; new's own
// err_schema_new_needs_discs mirror -- dispose's own ToSchema case was
// missing entirely (issue #688), so neither a wrong count nor a
// non-ordinal/incompatible discriminant expression was ever diagnosed.
DIAG(err_schema_dispose_needs_discs, Error,
     "'dispose' for a pointer to schema '%0' needs 0 or %1 discriminant(s), "
     "got %2")
DIAG(err_schema_dispose_disc_type, Error,
     "discriminant '%0' of schema '%1' needs an ordinal value")
DIAG(err_schema_not_a_discriminant, Error, "schema '%0' has no discriminant '%1'")
DIAG(err_schema_arg_not_schematic, Error,
     "argument for parameter '%0' must be a '%1', got '%2'")
// ISO §6.6.5.3: new/dispose's extra arguments for a record with a variant
// part are its case-constants, one per nested variant level actually
// selected, each a value of that level's own tag type -- the same rule
// err_variant_label_type enforces at the declaration itself.  %0 is 'new'
// or 'dispose', so the two share one message instead of near-duplicates.
DIAG(err_variant_tag_arg_type, Error,
     "'%0' case-constant has type '%1', which is not compatible with "
     "variant tag type '%2'")
DIAG(err_variant_tag_arg_extra, Error,
     "'%0' was given more case-constants than '%1' has variant levels to select")

// EP §6.8.7: Structured value constructors
DIAG(err_constructor_type_not_found, Error, "type '%0' not found for value constructor")
DIAG(err_constructor_not_aggregate, Error, "value constructor type must be array, record, or set, got '%0'")
DIAG(err_record_constructor_unknown_field, Error, "field '%0' not found in record type '%1'")
// EP §6.4.1: 'value' initial-state specifier
DIAG(err_value_init_type_mismatch, Error, "'value' initializer type '%0' is not compatible with variable type '%1'")
// EP §6.7.5.6, §6.7.6.8: bind, unbind and binding take a bindable variable —
// an entire one, since there is nothing to bind a component of.
DIAG(err_bind_needs_variable, Error,
     "the first argument of '%0' must be a variable")
DIAG(err_bind_not_bindable, Error,
     "'%0' was not declared bindable, so it cannot be passed to '%1' "
     "(EP §6.4.1)")
// EP §6.4.1 leaves binding a variable that is not a file to the
// implementation; plang binds a file to an external path and nothing else.
DIAG(err_bind_nonfile_unsupported, Error,
     "'%0' is of type '%1'; plang can bind only a file variable")
DIAG(err_bind_needs_binding_type, Error,
     "the second argument of 'bind' must be of type 'BindingType', not '%0'")
// EP §6.11.3: two imports may not introduce distinct objects into the same
// scope under one identifier.
DIAG(err_import_name_clash, Error, "'%0' is imported from both '%1' and '%2'")
// EP §6.11.3: an import clause names an interface, which must be one this
// compilation unit declares or can find an interface file for.
DIAG(err_unknown_module, Error,
     "no module named '%0' was found; it must be defined in this file or have "
     "an interface file on the module search path")
// A .pmi found on the search path but broken -- distinct from err_unknown_module
// so "regenerate the interface file" isn't confused with "write the module".
DIAG(err_malformed_module_interface, Error,
     "module interface for '%0' at '%1' could not be parsed: %2")
DIAG(err_module_interface_name_mismatch, Error,
     "module interface at '%0' does not declare '%1'%2")
// EP §6.11.3: the import-list may only name what the interface exports.
DIAG(err_import_name_not_exported, Error,
     "'%0' is not exported by module '%1'")
// EP §6.11.2: an export-range is written 'first..last' over the constants of
// one enumerated type.
DIAG(err_export_range_not_constants, Error,
     "'%0..%1' is not a range of constants of one enumerated type")
// EP §6.11.2: a variable exported 'protected' is readable but not assignable
// where it is imported.
DIAG(err_protected_import_assigned, Error,
     "'%0' is exported protected and cannot be assigned to here")
// EP §6.11.1: a module interface part promises a body; this file never
// supplies one (module Foo interface; ... end. with no matching
// module Foo; ... end. anywhere in it).  Left unchecked this compiled
// silently -- no .pmi under -c, or an undefined __plang_init_<name> at link
// time from whatever later imported it -- so the mistake surfaced far from
// where it was made.
DIAG(err_module_interface_without_implementation, Error,
     "module '%0' has an interface part but no matching implementation part")
// Turbo Tier 4, Cluster A item 2: 'uses' names a unit that
// Sema::loadUnitInterfaceExports could not find as EITHER a published
// interface file ('<name-lowercased>.tui', written by a prior `plang -c`
// compile of that unit -- see buildTUIContent/writeTUIFiles in
// Frontend.cpp) OR a source file ('<name-lowercased>.pas', parsed on the
// spot for Sema-only checking, no object code) anywhere on the module
// search path or in the current directory.  Distinct diagnostic from EP's
// own err_unknown_module: a Turbo 'uses' clause names a whole unit, not a
// module import, so the search failure means something different to a
// reader.
DIAG(err_unknown_unit, Error,
     "no unit named '%0' was found; it must exist as '%1.tui' (a published "
     "unit interface) or '%1.pas' (source) on the unit search path or in "
     "the current directory")
// A candidate '<name>.pas' file exists but does not parse as a unit file at
// all (a plain program, a syntax error, ...).
DIAG(err_malformed_unit, Error,
     "unit '%0' at '%1' could not be parsed as a unit: %2")
// A candidate '<name>.pas' file parses as a unit, but declares a different
// unit name than the 'uses' clause asked for (a stale copy, a rename, ...).
DIAG(err_unit_name_mismatch, Error,
     "'%1' at '%0' declares unit '%2', not '%1'")
// This item's own temporary loader has no transitive/circularity story of
// its own (that is item 2's job, building the real interface-file
// mechanism) -- it only refuses to recurse into a unit that is already
// being loaded, so a genuine cycle is reported once instead of overflowing
// the stack.
DIAG(err_unit_circular_uses, Error,
     "circular 'uses': unit '%0' is used while it is still being loaded")
// Issue #709: a 'uses' clause naming the same unit twice (`uses Base,
// Base;`) brings nothing new the second time -- fpc rejects it outright
// ('Duplicate identifier') rather than silently accepting the redundant
// name, and plang now matches that.
DIAG(err_unit_duplicate_uses, Error,
     "duplicate 'uses': unit '%0' is already used")
// Issue #709: a unit naming itself in its own 'uses' clause is not a real
// import (there is nothing to load that is not already this same
// compilation) -- an INTERFACE self-use is already caught as a circular
// load by err_unit_circular_uses above (loadUnitInterfaceExports's own
// UnitLoading_ guard), but an IMPLEMENTATION self-use reaches
// pushUnitUsesScopes only after checkUnitInterfaceOnly has already cached
// this unit's own exports, so it would otherwise be accepted as a
// (harmless-looking, but nonsensical) cache hit instead of being caught by
// that same guard.
DIAG(err_unit_self_uses, Error,
     "unit '%0' may not use itself")
// Issue #180/#304: neither a .pmi nor a .tui carries any version/fingerprint
// metadata that would let a reader detect a mismatch against the source it
// was published from, so this substitutes the cheap mtime-based check a
// make/ninja-style build already does -- a companion '<name>.pas' sitting in
// the SAME directory as the interface file that is NEWER than it (or than
// its paired '<name>.o', when one exists) means the interface/object was
// published before the source's last edit and is likely stale.  Deliberately
// a warning, not an error: a false positive (source touched but unchanged in
// any way that matters, a checked-out tree with only the source's mtime
// bumped by e.g. `git checkout`) must not turn into a build failure for
// every already-published interface file on upgrade.
DIAG(warn_stale_interface_file, Warning,
     "'%0' may be stale: its source '%1' was modified more recently; "
     "recompile '%1' to refresh it")
// Turbo's Integer/Byte/ShortInt/Word/LongInt are genuinely narrower than the
// one 64-bit Integer ISO 7185/EP always have (Type::Width, see its comment),
// so an arithmetic constant-expression that is a perfectly ordinary fold
// under those dialects can still overflow the narrower type it targets under
// Turbo -- `30000 + 30000` is nowhere near int64's range but is 27233 past
// Integer's.  Every OTHER place a folded constant is required already has
// its own "not a constant expression" diagnostic for a decline (e.g.
// err_array_lower_bound_not_const); this is the one for a plain `const`
// declaration, which has none, so it used to silently define a constant
// with no known ordinal value -- and every place that read it back, if
// nothing else needed the value to be constant, saw no error at all.
DIAG(err_const_expr_out_of_range, Error,
     "constant expression is out of range for type '%0' (must be between %1 and %2)")

// --------------------------------------------------------------------------
// Warnings
//
// Each of these reports something the standard permits a processor to leave
// alone: either an error §5.1 f) 1) allows to go unreported, or a construct
// that is well formed but cannot have been meant.  A warning's name on the
// command line is its identifier here without "warn_" and with hyphens for
// underscores, so warn_const_div_zero answers to -Wno-const-div-zero.
// --------------------------------------------------------------------------

// §6.7.2.2: division by zero is an error.  When the divisor is a constant the
// error is certain wherever the expression is reached, so it is worth saying
// before the program runs — but a warning and not an error, because a
// statement that is never reached commits no error.
DIAG(warn_const_div_zero, Warning,
     "'%0' by a constant zero; this is an error whenever it is reached")
// §6.4.6, §6.8.2.2: a value assigned to a variable of a subrange type must lie
// within that subrange.  A constant that does not is certain to trap.
// The type is not named as well as its bounds: a subrange type's name is those
// same bounds written again, and written worse, since it spells them as the
// ordinals underneath rather than as the characters or the enumeration
// identifiers the program used.  'Q' is outside the range 'a'..'z' says
// everything that 'Q' is outside the range 'a'..'z' of type 'char 97..122'
// does.
DIAG(warn_const_out_of_range, Warning,
     "%0 is outside the range %1..%2; this is an error whenever it is reached")
// §6.8.3.9: after a for-statement the control variable is undefined, so
// reading it without assigning it again gets whatever the storage held.
DIAG(warn_for_var_after_loop, Warning,
     "'%0' is undefined here: a for-statement leaves its control variable "
     "undefined when it finishes")
// §6.5.1: a variable that is read before it is given a value has whatever
// value its storage held.
DIAG(warn_var_uninitialized, Warning,
     "'%0' is read here before it has been given a value")
// §6.6.2: the value of a function is the last value assigned to its result;
// a path that assigns nothing leaves it whatever the storage held.
DIAG(warn_result_not_always_set, Warning,
     "'%0' does not assign to its result on every path through it")
// A statement no path can reach is dead code, and generally a mistake in the
// control flow around it rather than a deliberate one.
DIAG(warn_unreachable_code, Warning, "this statement cannot be reached")
// The range of the operand's type settles the comparison, so the other operand
// is not being consulted at all.
// TRANSLATORS: %0 is the word "true" or "false", supplied by the compiler.
// They are also Pascal keywords, so leaving them in English is correct.
DIAG(warn_compare_always, Warning,
     "comparison is always %0: '%1' is of type '%2', whose range is %3..%4")
// §6.8.3.5: a case-statement whose selector matches no case-constant is an
// error.  When the selector's type is small enough to enumerate, the values
// that would go unmatched can be named before the program runs.
// TRANSLATORS: %0 is a list of values built in English at the call site --
// joined with ", " and " or ", and ending " (and N more)" when there are
// too many to show.  Translating the joining words is not possible from here.
// Left as it is deliberately: it is one message, and the alternative is a
// list-formatting mechanism no other diagnostic would use.
DIAG(warn_case_not_exhaustive, Warning,
     "case does not cover %0 of type '%1', and has no 'otherwise' part; "
     "reaching it with such a value is an error")
// Not an error of any kind — a declaration that is never used is simply not
// doing anything, and is usually left over from an edit.
DIAG(warn_unused_variable, Warning, "'%0' is declared but never used")
DIAG(warn_unused_parameter, Warning, "parameter '%0' is never used")

// TP-only: Assert(cond: Boolean [; msg: string]) -- Builtins.def, gated on
// Switch::Assertions.  Type-checked the same way regardless of whether
// {$C-} will later compile the call away entirely (CGProcCall::emitCallStmt):
// a program with assertions off still gets told about a type error in a call
// it wrote.  The message argument reuses err_string_fn_arg_type -- the same
// "must be char or string" check EQ/LT/GT/... already give their own
// arguments -- rather than a second, near-identical diagnostic.
DIAG(err_assert_cond_not_boolean, Error,
     "condition of 'assert' must be boolean, got '%0'")

// TP-only: Break/Continue (Builtins.def) leave/skip the innermost
// while/for/for-in/repeat loop and are refused with no loop of their own to
// name -- checkCallStmt's own arm, gated on LoopDepth_ (Sema.h).  A nested
// procedure does not inherit its caller's loop context (LoopDepth_ is reset
// for its own body, checkProcBody), so `break`/`continue` written inside one
// that is itself called from a loop's body is refused here too, the same
// way `fpc -Mtp` itself refuses it ("BREAK not allowed", confirmed
// empirically).
DIAG(err_break_outside_loop, Error,
     "'break' is not valid outside a while, for, for-in or repeat loop")
DIAG(err_continue_outside_loop, Error,
     "'continue' is not valid outside a while, for, for-in or repeat loop")

// TP-only: Exit([value]) leaves the current procedure or function
// immediately; the optional value is FPC's extension to strict Delphi's
// argument-less Exit, and is legal only where CurrentRetType is non-null --
// inside a FUNCTION, never inside a procedure and never at a program's own
// top level, matching `fpc -Mtp`'s own "Procedures cannot return a value"
// (confirmed empirically) for exactly the same two cases.
DIAG(err_exit_value_outside_function, Error,
     "'exit' may only take a value inside a function; a procedure cannot return one")

// TP-only: real Turbo Pascal 7 ran on 16-bit real-mode DOS and exposed a
// family of standard identifiers for talking directly to that hardware/OS --
// segment/offset pointer manipulation (Seg, Ofs, Ptr, ...), raw memory/port
// access (Mem, Port, ...), heap-internals variables (HeapOrg, FreeList, ...)
// and low-level DOS/BIOS interrupt calls (Intr, MsDos, ...).  None of that
// has any meaning on plang's flat-address-space, 64-bit Linux/macOS target,
// and silently no-op'ing a call like `Intr($21, Regs)` would be far worse
// than refusing it outright.  isRealModeDosName (SemaExpr.cpp) is the one
// place that lists the names; this is the one diagnostic all of them share.
// It only ever fires once ordinary name resolution has already failed --
// a program's own declaration of, say, `Mem` as a variable always wins, the
// same as any other identifier -- so this is not a reserved word and is not
// registered as a Symbol.
DIAG(err_turbo_real_mode_facility, Error,
     "'%0' is a real-mode DOS facility and has no meaning under -std=turbo "
     "on this target")

// TP-only: procedural TYPES (`type TProc = procedure(x: integer);`) and
// VALUES -- variables of one, assignable from and callable through a
// matching routine -- layered on top of ISO §6.6.3.1's procedural/functional
// PARAMETER machinery.  A parameter is carried as a {entry point, frame}
// pair precisely so a nested, capturing routine can be passed through it; a
// procedural VARIABLE has no frame slot at all (CodeGen lowers it as one
// flat pointer), so Sema::checkRoutineValue refuses to put either kind of
// "might carry a frame" value into one: a routine whose own declaration is
// nested inside another (Symbol::IsNested), or a procedural PARAMETER (bound
// to who-knows-what at run time).  Real Turbo Pascal disallows both the same
// way; see checkRoutineValue's own comment for why capture is not analyzed
// more finely than "nested or not".
DIAG(err_procval_of_nested_routine, Error,
     "'%0' is a nested procedure or function and cannot be used as a "
     "procedural value; it depends on the storage frame of its enclosing "
     "procedure, which a procedural variable does not carry")
DIAG(err_procval_of_proc_param, Error,
     "'%0' is a procedural parameter and cannot be used as a procedural "
     "value; what routine it is bound to at run time -- possibly a nested "
     "one -- is not known here")
// Turbo procedural VALUES, issue #648: a call reached through an arbitrary
// procedural-typed EXPRESSION ('a[i](args)', 'p^(args)') rather than a
// declared routine name or a procedural PARAMETER -- CodeGen builds this
// call's signature straight from the callee's resolved Type (there is no
// single AST ProcedureTypeNode it was declared with in general), which
// cannot yet build the {entry point, frame} pair a NESTED procedural
// parameter within that signature would need.  Refused here rather than
// silently mismarshalled or reaching an internal compiler error.
DIAG(err_indirect_call_nested_proc_param, Error,
     "'%0' has a procedural parameter of its own, which is not supported "
     "when calling through an expression rather than a name")
// TP-only: Assigned(p) restricts its argument to a pointer or procedural
// value the same way Card restricts its own to a set (err_set_argument) --
// an arbitrary expression has no nil to compare against.
DIAG(err_assigned_argument, Error,
     "'%0' requires a pointer or procedural argument, got '%1'")
// TP-only: typed constants (`const X: Integer = 0;`).  Real TP7 requires the
// initializer to be a compile-time constant expression -- it is baked into
// the program's data segment once, not computed at start-up -- so an
// initializer that will not fold (a variable read, a function call, ...) is
// refused here the same way every other "wants a constant" site already is
// (see err_array_lower_bound_not_const and neighbors).
DIAG(err_typed_const_not_constant, Error,
     "initializer for typed constant '%0' is not a constant expression")
DIAG(err_typed_const_type_mismatch, Error,
     "initializer type '%0' is not compatible with typed constant '%1' of type '%2'")
// Turbo array literals `(1, 2, 3)` are positional, unlike EP's labeled
// `[1: 1; 2: 2; 3: 3]` -- so, unlike an EP array constructor, one that
// supplies too few or too many elements for the array's own declared extent
// has no bound left unwritten to default and no label to say which extra
// element was unwanted; it is simply wrong.
DIAG(err_typed_const_array_count_mismatch, Error,
     "typed constant '%0' initializes %1 element(s) but its array type has %2")
// Scope line for this first implementation of typed constants: a scalar
// (Integer/Real/Boolean/Char/enum) or a fixed (non-variant) record or array
// built from those lowers to a real compile-time llvm::Constant aggregate.
// A variant part has no one fixed layout to fold a literal into ahead of
// time, and string/set/file/pointer/procedural-typed constants need their
// own dedicated lowering this first pass does not attempt; cleanly refusing
// them is preferable to silently emitting a zero-filled or partial constant.
DIAG(err_typed_const_unsupported_type, Error,
     "typed constant '%0' has type '%1', which is not yet supported as a "
     "typed constant's type")

// TP-only: 'absolute' overlays a new variable's storage directly onto an
// existing one's -- `var W: Word absolute B;` -- rather than allocating
// storage of its own.  Not a reserved word (checkVarAbsolute's caller only
// recognizes it by spelling right after a var-declaration's type), so a
// program that happens to declare its own identifier called 'absolute' is
// completely unaffected outside that one position.
DIAG(err_absolute_multiple_names, Error,
     "'absolute' may overlay only a single variable, not a name list")
DIAG(err_absolute_target_not_variable, Error,
     "'absolute' must name a variable or a component of one")
// Issue #639: a program-scope 'absolute' has to resolve its target to a
// compile-time-constant ADDRESS (Sema.cpp's checkBlock, CodeGenProcs.cpp's
// globalAbsoluteAddr) -- fpc -Mtp enforces the identical restriction
// ("Illegal expression" for a non-constant index), confirmed empirically.
// The LOCAL case has no such limit (a real entry block is already open by
// the time it runs, so any designator's address can be computed there).
DIAG(err_absolute_global_component_not_const, Error,
     "'absolute' at program scope can only overlay a component reached by "
     "compile-time-constant array indices")

// TP-only: Extended (80-bit) and Comp (64-bit, fixed-point "currency")
// are real Turbo Pascal floating-family type names -- unlike a misspelled
// or simply nonexistent identifier, resolveNamedUnrestricted (SemaType.cpp)
// recognizes both by name under -std=turbo and refuses them explicitly
// here, rather than letting them fall into the generic err_undefined_type a
// program might mistake for a typo.  Real (64-bit) and, alongside it,
// Single (32-bit) are the only floating types this compiler can lower (see
// CGTypes::llvmTypeOfSemaTypeImpl's Real case) -- Extended's 80-bit x87
// format and Comp's distinct fixed-point representation each need a
// lowering and a runtime formatter of their own that do not exist.  Only
// under -std=turbo: ISO 7185/Extended Pascal never had these names as
// keywords at all, so outside Turbo they stay simply undefined, exactly as
// they were before this diagnostic existed.
DIAG(err_turbo_unsupported_float_type, Error,
     "'%0' is not a supported plang type; plang implements Turbo's Real and "
     "Single floating-point types but not Extended or Comp")
// TP-only: SizeOf(T)/High(T)/Low(T), T a type name or a value expression
// (Sema::resolveTypeArgOrValue, SemaExpr.cpp).  err_sizeof_unknown_size is
// Sema::byteSizeOf declining -- a conformant array parameter type or an
// undiscriminated schema, neither of which has one fixed size to report;
// in practice unreachable under -std=turbo today (schemas are EP-only) but
// checked rather than assumed, the same caution byteSizeOf's other callers
// already take. err_high_low_argument is High/Low's own argument shape
// check: an ordinal type/value answers directly and an array answers
// through its index type (High(arr)), and nothing else has bounds to give.
DIAG(err_sizeof_unknown_size, Error,
     "cannot determine the size of type '%0'")
DIAG(err_high_low_argument, Error,
     "'%0' requires an ordinal or array type, got '%1'")
// Turbo Tier 5, Cluster A item 7: TypeOf(x) -- x must be an object type/value
// (a type name or an expression, exactly like SizeOf/High/Low's own dual
// shape) with at least one virtual method somewhere in its own hierarchy, or
// there is no VMT for it to name.  Confirmed against a local fpc -Mtp build
// (typeof2.pas): fpc's own wording is "TYPEOF can only be used on object
// types with VMT", reused here verbatim rather than inventing new phrasing.
DIAG(err_typeof_argument, Error,
     "typeof can only be used on object types with VMT, got '%0'")
// TP-only: FPC's size-aware Hi/Lo/Swap all read or rearrange an integer
// value's own bytes, so the argument must be one at least 16 bits wide --
// Byte/ShortInt (8 bits) has no separate high and low half to name.  See
// Builtins.def's own comment on these three for the TP7-vs-FPC divergence.
DIAG(err_hi_lo_swap_argument, Error,
     "'%0' requires an integer argument of at least 16 bits, got '%1'")
// TP-only: Inc/Dec's argument must be ordinal or (Turbo, PChar-like) a
// pointer -- see checkCallStmt's own Inc/Dec arm for why a pointer this
// narrow rather than any typed pointer.
DIAG(err_inc_dec_argument, Error,
     "'%0' requires an ordinal or pointer argument, got '%1'")
// TP-only: TypeName(expr) is a VALUE typecast (Integer(SomeReal) converts:
// truncate/round/reinterpret the ordinal or real value) when both types are
// ordinal-or-real, and a VARIABLE typecast (TByteRec(SomeWord).Lo := 0, an
// lvalue reinterpreting the operand's own storage in place) when the two
// types are exactly the same size -- see Sema::checkTypeCast.  A cast that
// is neither -- different sizes and not both ordinal-or-real, e.g. casting a
// 3-byte record onto a 2-byte Word -- has no defined meaning either way.
DIAG(err_invalid_type_cast, Error,
     "cannot cast '%0' to '%1': the types must either both be ordinal or "
     "real (for a value conversion), or be the same size (for a variable "
     "reinterpretation)")
// TP-only: Val(s, v, code) -- v must be Integer- or Real-kind, any width;
// confirmed against `fpc -Mtp`, which refuses a Char/Boolean/Enum
// destination with its own "Integer or real expression expected" (a
// genuinely narrower rule than "ordinal", which Char/Boolean/Enum all are).
DIAG(err_val_argument, Error,
     "'val' requires an integer or real variable, got '%0'")

// TP-only: Turbo's `const` parameter (procedure P(const x: T)) -- read-only,
// parallel in spirit to EP's protected value parameter (err_protected_
// param_assigned/err_protected_import_assigned above) but a distinct flag
// and a distinct diagnostic naming 'const' specifically -- see
// ParamGroup::IsConst's own comment (AstType.h) for why the two are kept
// separate rather than merged.
DIAG(err_const_param_assigned, Error, "assignment to const parameter '%0'")
// TP-only, issue #603: a typed constant (`const X: T = ...`) is writable by
// default (`{$J+}`, Switch::WritableConst's own default in
// CompilerSwitches.def), matching TP7/FPC -Mtp's convention that a typed
// const behaves like a preinitialized variable unless the program opts into
// making it truly constant with `{$J-}`.  Symbol::IsTypedConst's own comment
// explains why this is a Var, not a Const, so this diagnostic -- fired only
// when WritableConst is off at the assignment's own location -- is the one
// place that actually enforces the switch; wording matches FPC -Mtp's own
// "Can't assign values to const variable".
DIAG(err_typed_const_not_writable, Error,
     "can't assign values to const variable '%0'")
// TP-only: Turbo's UNTYPED parameter (procedure P(var x), no ': type' at
// all).  Sema::checkIdent gives this whenever one is used bare -- as a
// plain value, a field/index base, an actual for a TYPED formal, and so on
// -- everything except the two legal uses of one: the operand of a
// variable typecast (Sema::checkTypeCast) and a direct relay to another
// untyped formal (Sema::checkCallArgs), both confirmed against fpc -Mtp.
DIAG(err_untyped_param_bare_use, Error,
     "untyped parameter '%0' can only be used through a type cast, or "
     "passed on to another untyped parameter")

// TP-only: FilePos/FileSize/Seek/Truncate/BlockRead/BlockWrite/Flush all
// operate on a typed or untyped BINARY file's raw record stream -- 'text'
// is a genuinely distinct predefined type under -std=turbo (isTextFile's
// own comment, Type.h), and real Turbo Pascal rejects a Text argument to
// any of these outright: confirmed against `fpc -Mtp`, whose own error for
// `FilePos(SomeTextVar)` is "Call by var for arg no. 1 has to match
// exactly: Got Text expected File", not some ad-hoc byte-level meaning the
// way SeekEof/SeekEoln (Text-only, the reverse restriction --
// err_line_proc_not_text) get.
DIAG(err_binary_file_required, Error,
     "'%0' requires a typed or untyped file, not '%1'")
