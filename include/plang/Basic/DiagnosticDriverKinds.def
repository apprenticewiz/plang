// DiagnosticDriverKinds.def — Driver diagnostics.
// Included by DiagnosticMessages.def.
//
// These are the only diagnostics with nothing to point at: the driver is
// reporting on the command line or on the toolchain, not on a place in a
// Pascal source file.  DiagnosticPrinter writes them under the program name
// instead of a file, line and column — "plang: error: no input files".
//
// A missing input file is not here.  The scanner already catalogs that as
// err_file_not_found, with the wording the driver was using anyway, and one
// message for one condition is the point of a shared catalog.

DIAG(err_no_input_files, Error, "no input files")
DIAG(err_arg_requires_value, Error, "%0 requires an argument")
DIAG(err_unknown_dialect, Error,
     "unknown Pascal dialect '%0'; valid dialects: %1")
DIAG(err_dialect_not_implemented, Error,
     "dialect '%0' is not yet implemented; implemented dialects: %1")

// Toolchain: plang drives llc and a linker.  On ELF targets that is ld.lld,
// linking against the C runtime that the host GCC installation provides the
// startup files for; on macOS it is the system ld, linking against the SDK.
DIAG(err_no_gcc_installation, Error,
     "could not detect GCC installation; set PLANG_GCC_DIR to override")
DIAG(err_no_c_library_dir, Error,
     "could not find system C library directory; set PLANG_LIB_DIR to override")
DIAG(err_no_macos_sdk, Error,
     "could not find the macOS SDK; install the Xcode command line tools "
     "with 'xcode-select --install', or set SDKROOT to override")
DIAG(err_cannot_find_program, Error, "cannot find '%0': %1")
DIAG(err_program_exec_failed, Error, "failed to execute '%0': %1")
// A subprocess that died on a signal rather than exiting.  Without this the
// driver returned llvm's -2 as its own status -- exit 254 and not one word of
// output -- so a compiler crash looked like a compiler that had quietly
// decided not to.  A silent failure is the one outcome worse than a loud one.
DIAG(err_program_crashed, Error, "'%0' crashed: %1")
DIAG(err_cannot_create_temp_file, Error, "cannot create temporary file: %0")

// An argument beginning with '-' that no option in Options.def matches.  A
// warning rather than an error because it costs nothing to carry on without
// it, and because a build system passing a flag plang does not know is a
// common enough thing that failing on it would be unkind.  -Werror still
// makes it fatal, which is the point of it having a name.
// TRANSLATORS: keep the spelling "unrecognized".  The warning this belongs
// to is named after its enumerator, so it is turned off with
// -Wno-unrecognized-argument; a message spelling it the other way would
// send a reader to a flag that does not exist.  A command line is syntax
// and is not translated, even between two spellings of English.
DIAG(warn_unrecognized_argument, Warning, "unrecognized argument '%0'")
// plang emits no debug metadata -- there is no DIBuilder in lib/CodeGen -- so
// -g cannot do what it says.  It used to be forwarded to llc, which has no such
// option, and every -g compile failed with "llc: Unknown command line argument
// '-g'".  Accepting it silently would be worse: a debugger would then open the
// program and show nothing, with the compiler having said the option was fine.
DIAG(warn_debug_not_implemented, Warning,
     "'-g' is accepted but plang does not emit debug information yet, so the "
     "program will have none")
