/// Version.h — plang version constants
///
/// GENERATED from Version.h.in by CMake.  Do not edit the generated copy, and
/// do not add a version here: the version is written once, in the root
/// CMakeLists.txt, and everything that states one derives it from there.  It
/// was written by hand in four places until 0.1.3, and they drifted.

#pragma once

#define PLANG_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define PLANG_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define PLANG_VERSION_PATCH @PROJECT_VERSION_PATCH@

/// The version as a human reads it, which in a build between releases carries a
/// pre-release suffix and so is not the same as MAJOR.MINOR.PATCH spelled out.
/// This is what --version, -dumpversion and the man page say.
#define PLANG_VERSION_STRING "@PLANG_VERSION_STRING@"
