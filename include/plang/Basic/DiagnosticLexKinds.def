// DiagnosticLexKinds.def — Scanner / lexer diagnostics.
// Included by DiagnosticMessages.def.

DIAG(err_file_not_found, Error, "no such file or directory: '%0'")
DIAG(err_source_too_large, Error, "source file '%0' is too large to compile")
DIAG(err_unterminated_comment, Error, "unterminated comment")
DIAG(err_comment_delim_mismatch, Error, "comment opened with '%0' must be closed with '%1' in Turbo Pascal mode")
DIAG(err_nondecimal_base_range, Error, "nondecimal literal base must be 2–36")
DIAG(err_nondecimal_no_digits, Error, "nondecimal literal has no digits")
DIAG(err_nondecimal_bad_digit, Error, "digit '%0' is out of range for base %1")
DIAG(err_nondecimal_literal_out_of_range, Error, "nondecimal literal is out of range")
DIAG(err_unterminated_string, Error, "unterminated string literal")
DIAG(err_unexpected_char, Error, "unexpected character: '%0'")
DIAG(err_hex_literal_no_digits, Error, "hexadecimal literal has no digits")
DIAG(err_hex_literal_out_of_range, Error, "hexadecimal literal is out of range")
DIAG(err_control_code_no_digits, Error, "control-character code has no digits")
DIAG(err_control_code_out_of_range, Error, "control-character code '%0' is out of range (must be 0-255)")

// Turbo `{$...}` compiler directives (lib/Lex/Directives.cpp).  The message
// directive family -- {$MESSAGE}/{$INFO}/{$NOTE}/{$HINT}/{$WARNING}/
// {$ERROR}/{$FATAL} -- each just echoes its own free-text argument as %0, at
// the severity Borland/FPC give that keyword ({$ERROR} and {$FATAL} both
// fail compilation like any other error). Real `fpc -Mtp` additionally
// aborts its OWN scan right where {$FATAL} stands; plang deliberately does
// not reproduce that half -- see Directives.cpp's header comment for why
// (no immediate-unwind mechanism, and truncating the buffer here was tried
// and just produces parser-cascade noise once the compile has already
// failed either way).
DIAG(note_directive_message, Info, "%0")
DIAG(note_directive_info, Info, "%0")
DIAG(note_directive_note, Info, "%0")
DIAG(warn_directive_hint, Warning, "%0")
DIAG(warn_directive_warning, Warning, "%0")
DIAG(err_directive_error, Error, "%0")
DIAG(err_directive_fatal, Error, "%0")
DIAG(warn_directive_unknown, Warning, "unknown compiler directive '%0'")

// Conditional compilation -- {$DEFINE}/{$UNDEF}/{$IFDEF}/{$IFNDEF}/{$ELSE}/
// {$ELSEIF}/{$ENDIF} (lib/Lex/Directives.cpp's dispatchConditionalDirective
// and skipToNextConditionalMarker).  Deliberately few diagnostics: a
// directive or a plain syntax error found while skipping a dead branch is
// never reported at all (see skipToNextConditionalMarker's own comment) --
// only the directive-nesting structure itself (a missing symbol name, an
// {$ELSE}/{$ELSEIF}/{$ENDIF} with nothing open to match, a second {$ELSE},
// or a conditional never closed by end of file) is a real error here.
DIAG(err_directive_expects_symbol, Error,
     "'%0' directive expects a single symbol name")
DIAG(err_directive_no_matching_ifdef, Error,
     "'%0' with no matching '{$IFDEF}'/'{$IFNDEF}'")
DIAG(err_directive_else_already_seen, Error,
     "'%0' after '{$ELSE}' for the same '{$IFDEF}'/'{$IFNDEF}'")
DIAG(err_directive_unterminated_conditional, Error,
     "no matching '{$ENDIF}' for this '%0' directive")

// `{$I file}`/`{$INCLUDE file}` (lib/Lex/Directives.cpp's
// dispatchIncludeDirective/resolveIncludePath/openInclude).  `{$I+}`/`{$I-}`
// are deliberately not among these: that is the (separately tracked, not
// yet dispatched -- CompilerSwitches.def's own task) IOChecks switch, and
// dispatchIncludeDirective leaves it alone, unhandled, so it keeps reaching
// warn_directive_unknown exactly as it did before this file existed.
DIAG(err_directive_include_expects_filename, Error,
     "'%0' directive expects a filename")
DIAG(err_directive_include_not_found, Error,
     "cannot open include file '%0'")
DIAG(err_directive_include_cycle, Error,
     "include cycle: '%0' is already being included")
