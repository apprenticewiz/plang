// DiagnosticParseKinds.def — Parser diagnostics.
// Included by DiagnosticMessages.def.

// Dialect gating.  Raised by the parser and by the analyzer alike, wherever a
// construct belongs to Extended Pascal (ISO 10206) and the source is being
// read as standard Pascal (ISO 7185).
//
// These were one diagnostic, "%0 is an Extended Pascal extension and is not
// available under -std=iso7185", with the subject passed in as an English noun
// phrase from each of ten call sites.  That cannot be translated: a language
// with grammatical gender or case needs the frame and the subject to agree,
// and English already needs a different article at each site.  So each
// construct says the whole sentence itself.
//
// Where the inserted text is not prose -- an operator, a type name, an
// identifier -- it stays an argument, because those are Pascal syntax and are
// not translated in any language.
DIAG(err_ep_underscore_in_identifier, Error,
     "an underscore in an identifier is an Extended Pascal extension and is "
     "not available under -std=iso7185")
DIAG(err_ep_operator, Error,
     "the operator '%0' is an Extended Pascal extension and is not available "
     "under -std=iso7185")
DIAG(err_ep_for_in, Error,
     "the 'for ... in' statement is an Extended Pascal extension and is not "
     "available under -std=iso7185")
DIAG(err_ep_case_otherwise, Error,
     "an 'otherwise' part of a case-statement is an Extended Pascal extension "
     "and is not available under -std=iso7185")
DIAG(err_ep_case_range, Error,
     "a range as a case-constant is an Extended Pascal extension and is not "
     "available under -std=iso7185")
DIAG(err_ep_type, Error,
     "the type '%0' is an Extended Pascal extension and is not available "
     "under -std=iso7185")
// checkEPOnly names which dialect(s) actually declare the name, rather than
// which one refused it: refused-by is Opts.Std, always known and never worth
// saying twice, but declares-in is Sym's own Dialects mask, and a name
// missing from the ACTIVE dialect can be missing from either of the other
// two -- iso7185 (the only dialect these four DIAGs were ever written for
// until -std=turbo existed) or turbo now as well.  "not available under
// -std=iso7185" is not just imprecise but backwards when turbo is what is
// active: it reads as a claim about the dialect in force, when the dialect
// in force is exactly the one already named on the command line.
DIAG(err_ep_required_name, Error,
     "'%0' is an Extended Pascal extension and is only available under "
     "-std=iso10206")
// Sema::checkEPOnly's other half, for a required name only -std=turbo
// declares (Assert, the first one) -- err_ep_required_name's own wording
// would be actively wrong here, not just imprecise: it reads as a promise
// that -std=iso10206 accepts the name, and no dialect but Turbo does.
DIAG(err_turbo_required_name, Error,
     "'%0' is a Turbo Pascal extension and is only available under "
     "-std=turbo")
// A third shape checkEPOnly's Dialects switch has to name: Halt and Length
// are both iso10206's and turbo's, so unlike the plain EP-only case above,
// -std=iso10206 is not the only place this name works -- and unlike it,
// this one only ever fires under -std=iso7185, the sole dialect missing
// from a two-bit mask that already has the other two.
DIAG(err_ep_turbo_required_name, Error,
     "'%0' is available under -std=iso10206 and -std=turbo, but not under "
     "-std=iso7185")
// ISO 7185's file-buffer model -- get, put, page, pack and unpack -- is not
// an Extended Pascal extension at all (iso7185 has all five); it is what
// -std=turbo replaces rather than lacks, with Assign and Seek instead.
// err_ep_required_name's frame ("is an Extended Pascal extension") would be
// simply wrong for a name iso7185 itself declares, so this family gets its
// own wording naming what actually happened to it under Turbo.
DIAG(err_turbo_file_model_name, Error,
     "'%0' is part of Pascal's file-buffer model, which -std=turbo "
     "replaces with Assign and Seek")
// Sema::checkDeref's File arm: ISO §6.5.5's buffer variable, `f^`, is the
// other half of the same file-buffer model err_turbo_file_model_name refuses
// get/put/page/pack/unpack for -- and is not a name at all, so it cannot
// reuse that DIAG's '%0' the way those five do.  No argument: unlike a
// builtin's own spelling, "f^" is generic Pascal notation for any file
// variable's buffer, not literally this one's.
DIAG(err_turbo_file_buffer_var, Error,
     "the file buffer variable ('f^') is part of Pascal's file-buffer "
     "model, which -std=turbo replaces with Assign and Seek")
DIAG(err_ep_two_arg_form, Error,
     "the two-argument form of '%0' is an Extended Pascal extension and is "
     "not available under -std=iso7185")
// EP §6.6: 'function F(...) = result: T' names the result variable instead
// of leaving it as F itself.  Parsed unconditionally until now (issue found
// during a review of the {$X} declaration-parsing area): a program compiled
// under -std=iso7185 with a named result variable was silently accepted,
// though §6.6.1's own grammar has no '=' in a function-heading at all.
DIAG(err_ep_named_result, Error,
     "a named result variable ('function name(...) = result: type') is an "
     "Extended Pascal extension and is not available under -std=iso7185")

// Distinct from err_ep_underscore_in_identifier above: this fires even where
// underscores ARE allowed (EP), because ISO 10206 §6.1.3's grammar --
// identifier = letter { [ underscore ] ( letter | digit ) } . -- only ever
// places an underscore between two other constituents.  Its own NOTE spells
// this out: "An identifier cannot begin or end with an underscore, nor can
// two underscores be adjacent."
DIAG(err_ep_underscore_placement, Error,
     "an identifier shall not begin or end with an underscore, nor contain "
     "two adjacent underscores")

// ISO 7185 §6.6.3.7.1: the packed form of a conformant array schema takes one
// index-type-specification; the unpacked form is the one that may have several.
DIAG(err_packed_conformant_shape, Error,
     "a packed conformant array parameter has one dimension")

// TP-only: EP/ISO 7185 Level 1's conformant-array-schema form
// (array [lo..hi: T] of E) never existed in real Turbo Pascal -- confirmed
// with a local fpc -Mtp check, which rejects it outright -- so it is
// rejected here too rather than silently accepted the way it would be by
// falling through to the ordinary array-type-expr parse.  Turbo's OWN open-
// array parameter form (array of T, no bracket at all) is parsed instead;
// see parseParamGroup's own comment for how the two are told apart.
DIAG(err_turbo_conformant_array, Error,
     "Turbo Pascal has no conformant array parameters (array[lo..hi: T] of "
     "E); use an open array parameter (array of T) instead")

// TP-only: 'const' and 'var' are mutually exclusive parameter-passing
// mechanisms -- const means read-only, var means a mutable reference --
// confirmed with a local fpc -Mtp check, which rejects 'const var x: T'
// with a syntax error ("identifier expected but VAR found").  Accepting
// both together would make G.IsVar pass the parameter by reference while
// G.IsConst only blocks a direct assignment, letting mutating builtins
// (Inc/Dec/Read/etc.) write through what looks like a const parameter.
DIAG(err_const_var_combined, Error,
     "'const' and 'var' cannot be combined on the same parameter")

DIAG(err_expected_type_expr, Error, "expected type expression, got %0")
DIAG(err_expected_label, Error, "expected label (integer or identifier), got %0")
DIAG(err_expected_goto_label, Error, "expected label after 'goto', got %0")
DIAG(err_unexpected_int_literal, Error, "unexpected integer literal in statement position")
DIAG(err_expected_assign_after_var, Error, "expected ':=' after variable reference")
DIAG(err_expected_to_or_downto, Error, "expected 'to' or 'downto' in for statement, got %0")
DIAG(err_int_literal_out_of_range, Error, "integer literal '%0' is out of range")
DIAG(err_real_literal_out_of_range, Error, "real literal '%0' is out of range")
DIAG(err_expected_expr, Error, "expected expression, got %0")
DIAG(err_expr_too_deeply_nested, Error, "expression is nested too deeply")
DIAG(err_type_too_deeply_nested, Error, "type is nested too deeply")
DIAG(err_stmt_too_deeply_nested, Error, "statement is nested too deeply")
DIAG(err_proc_too_deeply_nested, Error,
     "procedure or function declaration is nested too deeply")
DIAG(err_value_too_deeply_nested, Error, "structured value is nested too deeply")
DIAG(err_expected_token, Error, "expected %0, got %1")
DIAG(err_expected_token_got_lexeme, Error, "expected %0, got %1 '%2'")

// The last two diagnostics that were raw strings passed straight to the
// engine.  They had no identifier, so they could not be translated, could not
// be given a -W name, and did not appear in the catalog a translator reads.
DIAG(err_restricted_needs_type_name, Error,
     "'restricted' must be followed by the name of a type")
DIAG(err_module_to_needs_begin_or_end, Error,
     "'to' in module body must be followed by 'begin' or 'end'")
