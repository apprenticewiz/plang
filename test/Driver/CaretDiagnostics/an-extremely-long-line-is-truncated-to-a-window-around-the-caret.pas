(*
Issue #303: DiagnosticPrinter::printSnippet echoed the offending source
line in full with no length cap, so one absurdly long line produced a
diagnostic almost as long as the line itself -- unbounded by anything
short lines do. The line below is ~40KB, all but the very end of it
irrelevant filler; the diagnostic must instead show a small window
around the error column, elided with "...", with the caret still
landing on the right character *within that window*, and the whole
diagnostic must stay a couple hundred bytes, not tens of thousands.

RUN: not %plang %s -o %t 2> %t.err
RUN: FileCheck --check-prefix=ERR %s < %t.err
RUN: FileCheck --check-prefix=CARET --strict-whitespace --match-full-lines %s < %t.err
*)

(*
ERR: error: unexpected character: '`'
CARET:...                                                                                ` end.
CARET-NEXT:                                                                                   ^
*)

program p; begin                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                