# plang diagnostic messages -- Spanish.
#
# DRAFTED, NOT REVIEWED.  Every entry is marked "#, fuzzy", which means plang
# ignores it and prints the English instead.  That is deliberate: a
# mistranslated diagnostic sends someone looking for the wrong mistake, which
# is worse than reading English.  Clear the fuzzy flag on an entry once a
# native speaker has checked it, and that entry starts being used.
#
# To read the draft as it stands, compile with -fdiagnostics-show-fuzzy.
#
# %0..%9 are values plang substitutes.  Reorder them as the language needs, but
# use the same set: an entry that drops or invents one is refused and the
# English is used for it.  Text inside the %N is not translated -- it is a
# Pascal identifier, type name or operator.
#
msgid ""
msgstr ""
"Project-Id-Version: plang\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
